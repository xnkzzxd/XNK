/* ═══ T-2251: pita mode baca saja (langganan coach di hub). Tenang: abu-abu, bukan merah. ═══ */
.ro-band { display: flex; gap: 12px; align-items: flex-start; margin: 0 0 12px; padding: 12px 14px; border: 1px solid var(--border-strong); border-radius: 14px; background: var(--surface-2); color: var(--fg); font-size: var(--fs-sm, 0.9rem); line-height: 1.45; }
.ro-band.hide { display: none; }
.ro-band .ro-ic { flex: none; display: inline-flex; color: var(--fg-2); margin-top: 1px; }
.ro-band .ro-ic svg { width: 18px; height: 18px; }
.ro-band .ro-tx { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.ro-band b { font-weight: 700; }
.ro-band span { color: var(--fg-2); overflow-wrap: anywhere; }
.ro-band .ro-note { color: var(--fg-muted); }
