/* ── KPI ─────────────────────────────────────────────────────────────────── */
.kpi-grid { display: grid; gap: 12px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
@media (min-width: 1024px) { .kpi-grid.five { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
.kpi {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  min-height: 118px;
  box-shadow: var(--shadow-1);
}
.kpi .kpi-icon { width: 36px; height: 36px; border-radius: 12px; background: var(--surface-2); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; }
.kpi .kpi-label { font-size: var(--fs-xs); font-weight: 600; color: var(--fg-muted); }
.kpi .kpi-value { font-size: var(--fs-3xl); font-weight: 800; letter-spacing: -0.03em; line-height: 1; }
.kpi .kpi-note { font-size: var(--fs-2xs); color: var(--fg-muted); font-weight: 600; }
.kpi.wide { grid-column: span 2; }
.kpi.ink { background: var(--ink); color: var(--on-ink); border-color: var(--ink); }
.kpi.ink .kpi-label, .kpi.ink .kpi-note { color: var(--on-ink-muted); }
.kpi.ink .kpi-icon { background: color-mix(in srgb, var(--on-ink) 10%, transparent); border-color: transparent; }

/* ── Chip, pill, status ─────────────────────────────────────────────────── */
/* ── Mode latihan (Fase M): layar penuh, kartu gerakan, baris set, timer istirahat ── */
.wl { position: fixed; inset: 0; z-index: 55; display: flex; flex-direction: column; background: var(--bg); color: var(--fg); opacity: 0; transform: translateY(16px); transition: opacity var(--t-base) var(--ease), transform var(--t-base) var(--ease-out); }
.wl.open { opacity: 1; transform: none; }
html.wl-on, html.wl-on body { overflow: hidden; }
.wl-top { flex: none; display: flex; align-items: center; gap: 8px; min-height: 60px; padding: 8px 12px; padding-top: calc(8px + var(--sa-t)); background: var(--surface); border-bottom: 1px solid var(--border); }
.wl-head { flex: 1; min-width: 0; }
.wl-title { font-size: var(--fs-lg); font-weight: 800; letter-spacing: -0.01em; margin: 0; }
.wl-sub { margin: 0; font-size: var(--fs-sm); color: var(--fg-muted); }
.wl-top .btn { min-height: 44px; }
.wl-body { flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 12px 16px calc(120px + var(--sa-b)); display: flex; flex-direction: column; gap: 10px; }
.wl-pad-x { padding: 8px 0; display: flex; flex-direction: column; gap: 12px; }
.drag-grip { flex: none; width: 32px; min-height: 44px; display: grid; place-items: center; color: var(--fg-muted); cursor: grab; touch-action: none; }
.drag-grip svg { width: 18px; height: 18px; }
.dragging { position: relative; z-index: 3; box-shadow: var(--shadow-2); transition: none !important; }
.wl-note { margin: 0; font-size: var(--fs-sm); color: var(--fg-2); display: flex; gap: 6px; align-items: flex-start; }
.wl-video { align-self: flex-start; min-height: 44px; }
/* Statistik + peta otot (Fase O) */
.wl-stats { flex: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)) 72px; align-items: center; gap: 8px; padding: 10px 16px; border-bottom: 1px solid var(--border); background: var(--bg); }
.wl-stats:empty { display: none; }
.wl-st { display: flex; flex-direction: column; min-width: 0; }
.wl-st span { font-size: var(--fs-xs); color: var(--fg-muted); }
.wl-st b { font-size: var(--fs-lg); font-weight: 800; letter-spacing: -0.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.wl-st-dur { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }
.wl-mm { width: 72px; height: 68px; }
.wl-mm .mm { fill: color-mix(in srgb, var(--fg) 16%, transparent); stroke: none; transition: fill var(--t-base) var(--ease); }
.wl-mm .mm.on { fill: var(--fg); stroke: var(--fg); }
.mm-fig .mmf-body { fill: color-mix(in srgb, var(--fg) 6%, transparent); stroke: color-mix(in srgb, var(--fg) 22%, transparent); stroke-width: 3; }
.mm-fig .mmf-base { fill: color-mix(in srgb, var(--fg) 10%, transparent); }
.mm-fig .mmf { fill: color-mix(in srgb, var(--fg) 16%, transparent); transition: fill var(--t-base) var(--ease); }
.mm-fig .mmf.half { fill: color-mix(in srgb, var(--fg) 45%, transparent); }
.mm-fig .mmf.on { fill: var(--fg); animation: mmf-pulse 2.4s ease-in-out infinite; }
@keyframes mmf-pulse { 50% { opacity: .78; } }
/* Kartu gerakan + tabel set ala Hevy (Fase O) */
.wl-list { display: flex; flex-direction: column; gap: 10px; }
.wl-ex { border: 1px solid var(--border); border-radius: var(--r-md); background: var(--surface); padding: 2px 10px 10px 2px; display: flex; flex-direction: column; gap: 6px; scroll-margin: 12px 0 120px; transition: transform var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease); }
.wl-ex.cur { border-color: var(--fg); box-shadow: 0 0 0 1px var(--fg); }
.wl-ex.done:not(.cur) { background: var(--surface-2); }
.wl-ex.skipped { opacity: .6; }
.wl-ex-head { display: flex; align-items: center; gap: 0; min-height: 52px; }
.wl-ex-name { flex: 1; min-width: 0; min-height: 52px; margin: 0; padding: 0; display: flex; align-items: center; gap: 10px; font-size: var(--fs-lg); font-weight: 800; letter-spacing: -0.01em; background: none; border: 0; color: var(--fg); text-align: left; cursor: pointer; }
.wl-ex-name .truncate { min-width: 0; }
.wl-ex-name .pill { flex: none; }
.wl-thumb { flex: none; width: 44px; height: 44px; border-radius: 50%; object-fit: cover; background: var(--surface-3); border: 1px solid var(--border); }
.wl-thumb.ph, .ex-th.ph { display: grid; place-items: center; background: var(--surface-3); color: var(--fg-muted); }
.wl-thumb.ph svg { width: 20px; height: 20px; }
/* Fase U (T-1611): animasi gerakan sendiri (figure/rig.min.json). Monokrom, hanya transform yang bergerak. */
.rig-th { display: block; overflow: hidden; background: var(--surface-3); }
.rig-th .rig { display: block; width: 100%; height: 100%; transform: scale(1.35); transform-origin: 55% 60%; }
.mm-fig.rig .mmf-body { stroke-width: 1.4; fill: color-mix(in srgb, var(--fg) 7%, var(--surface)); stroke: color-mix(in srgb, var(--fg) 38%, transparent); }
.mm-fig.rig .mmf { fill: transparent; }
.mm-fig.rig .mmf.half { fill: color-mix(in srgb, var(--fg) 42%, transparent); }
.mm-fig.rig .mmf.on { fill: var(--fg); animation: none; }
.rig g { transform-box: view-box; transform-origin: 0 0; }
.rig .rg-eq { fill: color-mix(in srgb, var(--fg) 20%, transparent); }
.rig .rg-eq.soft { fill: none; }
.rig .rg-eq-l { fill: none; stroke: color-mix(in srgb, var(--fg) 28%, transparent); stroke-width: 2.5; }
.rig .rg-cab { stroke: color-mix(in srgb, var(--fg) 40%, transparent); stroke-width: 1.2; vector-effect: non-scaling-stroke; }
.rig .rg-cab.thick { stroke-width: 5; }
.rig-big { display: grid; place-items: center; margin: 0 0 12px; border-radius: var(--r-lg, 16px); background: var(--surface-2); border: 1px solid var(--border); }
.rig-big .rig { width: min(100%, 280px); height: auto; aspect-ratio: 1; }
@media (prefers-reduced-motion: reduce) { .rig.anim g { animation: none !important; } }
.wl-ex-sub { margin: 0 0 0 10px; font-size: var(--fs-sm); color: var(--fg-muted); }
.wl-ex-sub b { color: var(--fg); }
.wl-ex-note { margin: 0 0 0 10px; display: flex; gap: 6px; align-items: flex-start; font-size: var(--fs-sm); color: var(--fg-2); }
.wl-ex-note svg { flex: none; width: 15px; height: 15px; margin-top: 2px; }
.wl-rest-link { align-self: flex-start; min-height: 44px; margin-left: 4px; padding: 0 6px; display: inline-flex; align-items: center; gap: 6px; background: none; border: 0; color: var(--fg); font-weight: 700; font-size: var(--fs-sm); cursor: pointer; }
.wl-rest-link svg { width: 16px; height: 16px; }
.wl-plate { font-variant-numeric: tabular-nums; }
.wl-tbl { display: flex; flex-direction: column; margin-left: 8px; }
.wl-tr { display: grid; grid-template-columns: 40px minmax(0, 1fr) 68px 56px 48px; gap: 6px; align-items: center; min-height: 52px; padding: 4px; border-radius: 10px; }
.wl-tbl.c1 .wl-tr { grid-template-columns: 40px minmax(0, 1fr) 96px 48px; }
.wl-tbl.c3 .wl-tr { grid-template-columns: 34px minmax(0, 1fr) 60px 48px 44px 48px; }
.wl-tbl.k-waktu .wl-tr { grid-template-columns: 40px minmax(0, 1fr) 124px 48px; }
.wl-tbl.k-waktu.c2 .wl-tr { grid-template-columns: 36px minmax(0, 1fr) 118px 44px 48px; }
.wl-th { min-height: 28px; font-size: var(--fs-2xs); font-weight: 800; letter-spacing: .04em; color: var(--fg-muted); text-align: center; }
.wl-th span:nth-child(2) { text-align: left; }
.wl-th svg { width: 14px; height: 14px; }
.wl-tr:nth-child(odd):not(.wl-th):not(.done) { background: var(--surface-2); }
.wl-tr.done { background: color-mix(in srgb, var(--fg) 12%, transparent); }
.wl-setno { min-height: 44px; border: 0; border-radius: 8px; background: none; color: var(--fg); font-weight: 800; font-size: 1rem; cursor: pointer; }
.wl-setno.k { color: var(--fg); text-decoration: underline; text-underline-offset: 3px; }
.wl-tr.warm .wl-setno { font-style: italic; }
.wl-prev { min-height: 44px; min-width: 0; padding: 0 4px; border: 0; background: none; color: var(--fg-muted); font-size: var(--fs-sm); font-weight: 600; text-align: left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; cursor: pointer; }
.wl-prev:disabled { cursor: default; }
.wl-td { position: relative; display: flex; justify-content: center; min-width: 0; }
.wl-in { width: 100%; min-width: 0; min-height: 44px; padding: 0 4px; border: 1.5px solid transparent; border-radius: 10px; background: var(--surface-3); color: var(--fg); font: inherit; font-size: 1rem; font-weight: 800; text-align: center; }
.wl-in::placeholder { color: var(--fg-muted); font-weight: 700; opacity: .8; }
.wl-in:focus { outline: none; border-color: var(--fg); background: var(--surface); }
.wl-tr.done .wl-in { background: transparent; }
.wl-ck { width: 44px; height: 44px; border-radius: 10px; border: 1.5px solid var(--border-strong); background: var(--surface); color: var(--fg-muted); display: grid; place-items: center; cursor: pointer; transition: background var(--t-fast) var(--ease), transform var(--t-fast) var(--spring); }
.wl-ck svg { width: 20px; height: 20px; stroke-width: 3; }
.wl-ck:active { transform: scale(.92); }
.wl-ck[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: var(--on-ink); }
.wl-trophy { position: absolute; top: -6px; right: -2px; font-size: .8125rem; line-height: 1; pointer-events: none; }
.wl-dur { display: flex; gap: 4px; width: 100%; }
.wl-play { flex: none; width: 44px; height: 44px; border-radius: 10px; border: 1.5px solid var(--border-strong); background: var(--surface); color: var(--fg); display: grid; place-items: center; cursor: pointer; }
.wl-play svg, .wl-watch svg { width: 16px; height: 16px; }
.wl-watch { width: 100%; min-height: 44px; border-radius: 10px; border: 0; background: var(--ink); color: var(--on-ink); display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 1rem; cursor: pointer; }
.wl-watch.run { animation: wlRun 1.2s var(--ease) infinite; }
@keyframes wlRun { 50% { opacity: .75; } }
.wl-addset { margin-left: 8px; width: calc(100% - 8px); min-height: 44px; }
.wl-start { display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center; padding: 28px 0 8px; max-width: 560px; width: 100%; margin: 0 auto; }
.wl-start h3 { margin: 4px 0 0; font-size: var(--fs-xl, 22px); font-weight: 800; }
.wl-start p { margin: 0 0 14px; }
.wl-start-ic { color: var(--fg-muted); }
.wl-start-ic svg { width: 56px; height: 56px; stroke-width: 1.5; }
.wl-end { display: flex; flex-direction: column; gap: 10px; margin-top: 6px; }
.wl-foot-btns { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; width: 100%; }
.wl-foot-btns .btn { min-height: 48px; }
.wl-set-list { display: flex; flex-direction: column; }
.wl-set-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 60px; padding: 10px 0; border-bottom: 1px solid var(--border); }
.wl-set-row:last-child { border-bottom: 0; }
.wl-set-row p { margin: 0; }
.wl-set-row .select { width: auto; max-width: 52%; min-height: 44px; font-size: 1rem; }
.wl-rest-chips { flex-wrap: wrap; }
.wl-rest-chips .chip { min-height: 44px; min-width: 72px; }
/* Kartu gerakan (lama, tetap dipakai) */
.wl-add { margin-top: 2px; }
.wl-menu-info { padding: 10px 12px; border-radius: 12px; background: var(--surface-2); }
.wl-menu-info p { margin: 0; }
.wl-empty { padding: 8px 0; }
.wl-hist { display: flex; flex-direction: column; gap: 2px; padding: 8px 10px; border-radius: 12px; background: var(--surface-2); }
.wl-hist-row { display: flex; align-items: center; gap: 8px; min-height: 52px; }
.wl-hist-row .btn { min-height: 44px; flex: none; }
.wl-rest { position: absolute; left: 12px; right: 12px; bottom: calc(12px + var(--sa-b)); max-width: 560px; margin: 0 auto; border-radius: 20px; background: var(--ink); color: var(--on-ink); box-shadow: var(--shadow-3); overflow: hidden; animation: fadeUp var(--t-base) var(--ease-out) both; }
.wl-rest-track { height: 6px; background: color-mix(in srgb, var(--on-ink) 18%, transparent); }
.wl-rest-fill { display: block; height: 100%; background: var(--on-ink); transform-origin: left center; transition: transform 250ms linear; }
.wl-rest-row { display: flex; align-items: center; gap: 6px; padding: 8px 8px 8px 14px; }
.wl-rest-lbl { flex: 1; min-width: 0; font-size: var(--fs-sm); color: var(--on-ink-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.wl-rest-t { font-size: 1.5rem; font-weight: 800; min-width: 64px; text-align: right; margin-right: 4px; }
.wl-rest .btn { min-height: 44px; }
.wl-rest .btn-secondary { background: color-mix(in srgb, var(--on-ink) 14%, transparent); color: var(--on-ink); border-color: transparent; }
.wl-rest .btn-primary { background: var(--on-ink); color: var(--ink); border-color: var(--on-ink); }
.wl-menu-btn { display: flex; align-items: center; gap: 12px; width: 100%; min-height: 52px; padding: 6px 12px; border-radius: 12px; border: 1px solid var(--border); background: var(--surface); color: var(--fg); text-align: left; cursor: pointer; }
.wl-menu-btn > span { display: flex; flex-direction: column; min-width: 0; }
.wl-menu-btn small { color: var(--fg-muted); font-size: var(--fs-xs); }
.wl-menu-btn.on { border-color: var(--fg); box-shadow: 0 0 0 1px var(--fg); }
.wl-menu-btn.danger { color: var(--fg); border-style: dashed; }
.wl-menu-btn svg { width: 18px; height: 18px; flex: none; }
.wl-menu-rest { display: flex; align-items: center; gap: 8px; min-height: 52px; padding: 4px 4px 4px 12px; border: 1px solid var(--border); border-radius: 12px; }
.wl-menu-rest > span { flex: 1; display: flex; align-items: center; gap: 12px; }
.wl-menu-rest svg { width: 18px; height: 18px; }
.wl-menu-rest .btn { min-height: 44px; min-width: 52px; }
.wl-faces { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; }
.wl-face { min-height: 64px; border-radius: 14px; border: 1px solid var(--border); background: var(--surface); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; cursor: pointer; color: var(--fg); }
.wl-face span { font-size: 1.5rem; line-height: 1; }
.wl-face small { font-size: var(--fs-2xs); color: var(--fg-muted); text-align: center; line-height: 1.1; }
.wl-face.on { border-color: var(--fg); box-shadow: 0 0 0 1.5px var(--fg); background: var(--surface-2); }
.wl-sum-row { display: flex; align-items: center; gap: 8px; padding: 6px 0; border-bottom: 1px solid var(--border); }
.wl-up, .wl-down { flex: none; font-weight: 800; font-size: var(--fs-sm); }
.wl-down { color: var(--fg-muted); }
.wl-prs { margin: 0; font-weight: 700; }
/* Lembar cari gerakan */
#ex-search { height: min(92dvh, 820px); }
.exs-head { flex: none; display: grid; grid-template-columns: 88px minmax(0, 1fr) 88px; align-items: center; padding: 0 8px 8px; }
.exs-head .sheet-title { text-align: center; margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.exs-head .exs-hbtn { min-height: 44px; padding: 0 8px; font-size: 1rem; font-weight: 600; color: var(--fg); text-decoration: none; }
.exs-head .exs-hbtn:last-child { justify-self: end; font-weight: 800; }
.exs-head .exs-hbtn:first-child { justify-self: start; }
.exs-top { flex: none; display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; padding: 0 20px 10px; border-bottom: 1px solid var(--border); }
.exs-top .input, .exs-top .select { font-size: 1rem; min-height: 44px; }
.exs-filters { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.exs-lbl { margin: 14px 0 4px; }
.ex-li { display: flex; align-items: center; gap: 4px; border-bottom: 1px solid var(--border); }
.ex-pick { flex: 1; min-width: 0; display: flex; align-items: center; gap: 14px; min-height: 68px; padding: 8px 4px; background: none; border: 0; color: var(--fg); text-align: left; cursor: pointer; }
.ex-li.on .ex-pick { box-shadow: inset 4px 0 0 var(--fg); padding-left: 12px; }
.ex-th { flex: none; width: 52px; height: 52px; border-radius: 50%; object-fit: cover; background: var(--surface-3); border: 1px solid var(--border); }
.ex-th.ph svg { width: 22px; height: 22px; }
.ex-pick .ex-t { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.ex-pick .ex-t b { font-weight: 700; font-size: 1rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ex-pick .ex-t span { font-size: var(--fs-sm); color: var(--fg-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ex-on { flex: none; width: 28px; height: 28px; border-radius: 50%; background: var(--ink); color: var(--on-ink); display: grid; place-items: center; }
.ex-on svg { width: 16px; height: 16px; stroke-width: 3; }
.ex-hbtn { flex: none; }
.ex-hist-box { display: flex; flex-direction: column; gap: 8px; padding: 10px 4px 14px; border-bottom: 1px solid var(--border); }
.exs-chips { display: flex; flex-wrap: wrap; gap: 6px; }
.exs-credit { flex: none; margin: 0; padding: 6px 20px calc(10px + var(--sa-b)); }
#exs-foot { padding-bottom: 4px; }
/* Halaman Latihan (Fase O): rutinitas ala Hevy */
.rt-empty-btn { display: flex; align-items: center; gap: 14px; width: 100%; min-height: 60px; padding: 0 18px; border-radius: var(--r-md); border: 1px solid var(--border); background: var(--surface); color: var(--fg); font-size: 1.0625rem; font-weight: 700; cursor: pointer; }
.rt-empty-btn svg { width: 24px; height: 24px; }
.rt-sec { display: flex; align-items: center; gap: 2px; margin-top: 6px; }
.rt-sec .section-title { flex: 1; margin: 0; }
.rt-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.rt-act { display: flex; align-items: center; gap: 10px; min-height: 56px; padding: 0 14px; border-radius: var(--r-md); border: 1px solid var(--border); background: var(--surface); color: var(--fg); font-weight: 700; font-size: .9375rem; cursor: pointer; text-align: left; }
.rt-act svg { flex: none; width: 22px; height: 22px; }
.rt-group { display: flex; flex-direction: column; gap: 10px; }
.rt-gbtn { align-self: flex-start; display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 4px; background: none; border: 0; color: var(--fg-muted); font-size: 1rem; font-weight: 600; cursor: pointer; }
.rt-gbtn svg { width: 18px; height: 18px; }
.rt-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
.rt-card { display: flex; flex-direction: column; gap: 12px; padding: 16px; border-radius: var(--r-lg, 18px); border: 1px solid var(--border); background: var(--surface); }
.rt-head { display: flex; align-items: flex-start; gap: 4px; }
.rt-open { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; padding: 0; background: none; border: 0; color: var(--fg); text-align: left; cursor: pointer; }
.rt-name { display: flex; align-items: center; gap: 8px; min-width: 0; }
.rt-name b { font-size: 1.1875rem; font-weight: 800; letter-spacing: -0.01em; min-width: 0; }
.rt-name .pill { flex: none; }
.rt-sub { color: var(--fg-muted); font-size: var(--fs-sm); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.rt-head .icon-btn { margin: -8px -8px 0 0; }
.rt-go { min-height: 48px; font-size: 1rem; }
.rt-chart { display: flex; flex-direction: column; gap: 8px; }
.rt-big { margin: 0; display: flex; align-items: baseline; gap: 8px; }
.rt-big b { font-size: 1.375rem; font-weight: 800; }
.rt-big span { color: var(--fg-muted); font-weight: 700; }
.rt-nochart { display: flex; align-items: center; gap: 8px; padding: 12px; border-radius: 12px; background: var(--surface-2); margin: 0; }
.rt-nochart svg { width: 18px; height: 18px; flex: none; }
.rt-ex { display: flex; flex-direction: column; gap: 6px; }
.rt-ex p { margin: 0; }
.rt-ex-head { display: flex; align-items: center; gap: 12px; min-height: 48px; }
.rt-ex-head b { font-size: 1.0625rem; font-weight: 800; }
.rt-rest { display: flex; align-items: center; gap: 6px; font-weight: 700; font-size: var(--fs-sm); }
.rt-rest svg { width: 16px; height: 16px; }
.rt-tbl { display: flex; flex-direction: column; }
.rt-tr { display: grid; grid-template-columns: 56px 1fr; align-items: center; min-height: 40px; padding: 0 8px; border-radius: 8px; }
.rt-tbl.kg .rt-tr { grid-template-columns: 56px 1fr 1fr; }
.rt-tr:nth-child(odd):not(.rt-th) { background: var(--surface-2); }
.rt-th { min-height: 28px; font-size: var(--fs-2xs); font-weight: 800; letter-spacing: .04em; color: var(--fg-muted); }
.rt-tr span:first-child { font-weight: 800; }
.rt-xlist { margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 4px; font-size: var(--fs-sm); color: var(--fg-2); }
/* Bar latihan berjalan / belum terkirim */
.wl-resume { position: fixed; left: 14px; right: 14px; max-width: 460px; margin: 0 auto; bottom: calc(var(--tabbar-space) + 14px); z-index: 44; display: flex; align-items: center; gap: 10px; min-height: 60px; padding: 6px 6px 6px 8px; border-radius: 18px; background: var(--ink); color: var(--on-ink); box-shadow: var(--shadow-3); animation: fadeUp var(--t-base) var(--ease-out) both; }
.wl-res-ico { flex: none; width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; background: color-mix(in srgb, var(--on-ink) 14%, transparent); }
.wl-res-ico svg { width: 20px; height: 20px; }
.wl-res-ico.live svg { animation: wlPulseIco 1.6s var(--ease) infinite; }
@keyframes wlPulseIco { 50% { transform: scale(1.12); } }
.wl-res-t { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.wl-res-t b { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.wl-res-t small { color: var(--on-ink-muted); font-size: var(--fs-xs); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.wl-resume .btn { min-height: 44px; background: var(--on-ink); color: var(--ink); border-color: var(--on-ink); }
html.wl-res-on .save-bar { bottom: calc(var(--tabbar-space) + 86px); }
html.wl-res-on #main-scroll-area .page { padding-bottom: 96px; }
/* Editor program berbentuk form */
.pf-day { display: flex; flex-direction: column; gap: 8px; padding: 10px; }
.pf-day-head { display: flex; align-items: center; gap: 2px; }
.pf-day-head .pf-hari { flex: 1; min-width: 0; font-weight: 800; font-size: 1rem; }
.pf-list { display: flex; flex-direction: column; gap: 6px; }
.pf-item { border: 1px solid var(--border); border-radius: 14px; background: var(--surface); transition: transform var(--t-fast) var(--ease); }
.pf-item.open { border-color: var(--fg); }
.pf-item.joined { margin-top: -2px; border-left: 3px solid var(--fg); }
.pf-row { display: flex; align-items: center; gap: 2px; min-height: 56px; padding-right: 2px; }
.pf-gif { width: 40px; height: 40px; border-radius: 8px; object-fit: cover; flex: none; background: var(--surface-2); }
.pf-sum { flex: 1; min-width: 0; display: flex; flex-direction: column; min-height: 52px; justify-content: center; padding: 4px 6px; text-align: left; background: none; border: 0; color: inherit; cursor: pointer; }
.pf-sum b { font-weight: 700; display: flex; align-items: center; gap: 6px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.pf-sum > span { font-size: var(--fs-sm); color: var(--fg-muted); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.pf-row .icon-btn[disabled] { opacity: .3; }
.pf-edit { display: flex; flex-direction: column; gap: 10px; padding: 4px 12px 12px; border-top: 1px solid var(--border); padding-top: 10px; }
.pf-edit .label { display: block; margin-bottom: 4px; }
.pf-edit .input { font-size: 1rem; }
.pf-edit .chip, .exs-chips .chip { min-height: 44px; }
.pf-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
.pf-line { display: flex; align-items: center; gap: 6px; }
.pf-line .pf-kind { flex: 1; min-width: 0; font-size: 1rem; }
.rmd-acc { border-top: 1px solid var(--border); }
.rmd-acc > summary { min-height: 44px; display: flex; align-items: center; gap: 8px; cursor: pointer; font-weight: 600; color: var(--fg-2); list-style: none; }
.rmd-acc > summary::-webkit-details-marker { display: none; }
.rmd-acc > summary svg { width: 18px; height: 18px; transition: transform .2s; }
.rmd-acc[open] > summary svg { transform: rotate(180deg); }
.rmd-acc-hint { margin-left: auto; font-weight: 500; color: var(--fg-muted); font-variant-numeric: tabular-nums; }
.rmd-acc-body { display: flex; flex-direction: column; gap: 12px; padding: 4px 0 6px; }
.pf-more { border-top: 1px solid var(--border); padding-top: 4px; }
.pf-more > summary { min-height: 44px; display: flex; align-items: center; cursor: pointer; font-weight: 700; color: var(--fg-2); }
.pf-more-body { display: flex; flex-direction: column; gap: 10px; padding-bottom: 4px; }
.pf-sk-foot { display: flex; align-items: flex-end; justify-content: space-between; gap: 8px; }
.pf-sk-foot .pf-num { width: 110px; }
.pf-num { display: flex; flex-direction: column; gap: 4px; font-size: var(--fs-xs); color: var(--fg-muted); }
.pf-num .input { text-align: center; min-height: 44px; padding: 0 6px; }
.pf-skema { display: flex; flex-direction: column; gap: 6px; }
.pf-sk-head, .pf-sk-row { display: grid; grid-template-columns: 28px minmax(0, 1fr) minmax(0, 1fr) 64px 44px; gap: 6px; align-items: center; }
.pf-sk-row.nokg, .pf-skema:has(.nokg) .pf-sk-head { grid-template-columns: 28px minmax(0, 1fr) 64px 44px; }
.pf-sk-head { font-size: var(--fs-xs); color: var(--fg-muted); text-align: center; }
.pf-sk-row .input { text-align: center; min-height: 44px; padding: 0 6px; }
.pf-sk-row .num { text-align: center; color: var(--fg-muted); font-weight: 700; }
.pf-w { display: flex; align-items: center; justify-content: center; min-height: 44px; min-width: 44px; cursor: pointer; }
.pf-w input, .pf-check input { width: 20px; height: 20px; accent-color: var(--fg); }
.pf-check { gap: 10px; min-height: 44px; align-items: center; cursor: pointer; }
.pf-del { align-self: flex-start; min-height: 44px; }
@media (min-width: 768px) {
  .wl-body { padding: 16px 24px 120px; }
  .wl-top { padding-left: 20px; padding-right: 20px; }
  .wl-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 12px; align-items: start; max-width: 1180px; width: 100%; margin: 0 auto; }
  .wl-add, .wl-body > .wl-empty { max-width: 1180px; width: 100%; margin-left: auto; margin-right: auto; }
  .pf-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .exs-top { grid-template-columns: minmax(0, 1fr) 360px; padding: 0 24px 10px; }
  .rt-grid { grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .wl-stats { padding: 10px 24px; grid-template-columns: repeat(3, 160px) 72px; justify-content: start; }
  .wl-rest { left: auto; right: 24px; bottom: 24px; width: 460px; }
  .wl-resume { left: auto; right: 24px; bottom: 24px; width: 420px; }
  html.wl-res-on .save-bar { bottom: 28px; }
}
@media (prefers-reduced-motion: reduce) { .wl, .wl-ck, .wl-rest-fill, .wl-mm .mm, .mm-fig .mmf { transition: none; } .mm-fig .mmf.on { animation: none; } .wl-watch.run, .wl-res-ico.live svg { animation: none; } }
.wk-sum { display: grid; grid-template-columns: repeat(auto-fit, minmax(72px, 1fr)); gap: 8px; }
.wk-sum > div { display: flex; flex-direction: column; }
.wk-big { font-size: var(--fs-xl, 22px); font-weight: 800; letter-spacing: -0.02em; }
.wk-block { display: flex; flex-direction: column; gap: 6px; padding-top: 10px; border-top: 1px solid var(--border); }
.wk-bar { fill: var(--border-strong); }
.wk-bar.cur { fill: var(--fg); }
.wk-part { display: grid; grid-template-columns: 84px minmax(0, 1fr) auto; gap: 8px; align-items: center; }
.wk-track { height: 8px; border-radius: 99px; background: var(--surface-3); overflow: hidden; }
.wk-fill { display: block; height: 100%; border-radius: 99px; background: var(--fg); }
.ex-row { display: flex; align-items: center; gap: 10px; width: 100%; min-height: 56px; padding: 4px 8px 4px 4px; border: 1px solid var(--border); border-radius: 12px; background: var(--surface); color: var(--ink); text-align: left; cursor: pointer; }
.ex-row:active { transform: scale(0.98); }
.ex-row img, .ex-row .ex-ph { width: 48px; height: 48px; flex: none; border-radius: 8px; background: var(--surface-2, var(--border)); object-fit: cover; }
.ex-row .ex-t { min-width: 0; flex: 1; }
.ex-row .ex-t b { display: block; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ex-row .ex-t span { font-size: var(--fs-xs, 12px); color: var(--ink-3, var(--ink)); }
.chips { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 2px; scrollbar-width: none; }
.chips::-webkit-scrollbar { display: none; }
.chip {
  flex-shrink: 0;
  min-height: 36px;
  padding: 0 14px;
  border-radius: var(--r-full);
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--fg-2);
  font-size: var(--fs-sm);
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: background var(--t-fast) var(--ease), color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease), transform var(--t-fast) var(--ease);
}
@media (hover: hover) { .chip:hover { border-color: var(--border-strong); } }
.chip:active { transform: scale(0.96); }
.chip.active { background: var(--ink); border-color: var(--ink); color: var(--on-ink); }
.chip .chip-count { font-size: var(--fs-2xs); opacity: 0.7; }
.pill {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  min-height: 24px;
  padding: 0 9px;
  border-radius: var(--r-full);
  font-size: var(--fs-2xs);
  font-weight: 800;
  letter-spacing: 0.02em;
  border: 1.5px solid var(--fg);
  color: var(--fg);
  white-space: nowrap;
}
.pill svg.lucide { width: 12px; min-height: 12px; stroke-width: 2.5; }
.pill.solid { background: var(--fg); color: var(--bg); }
.pill.dashed { border-style: dashed; }
.pill.soft { border-color: var(--border-strong); color: var(--fg-muted); }
.card-ink .pill { border-color: var(--on-ink); color: var(--on-ink); }
.card-ink .pill.solid { background: var(--on-ink); color: var(--ink); }
/* Konten (admin) dan Info & Tips (klien): satu kolom di HP, grid kartu dari 768 px */
.cn-wrap { display: flex; flex-direction: column; gap: var(--gap); width: 100%; max-width: 1100px; }
.cn-tools { display: flex; flex-direction: column; gap: 10px; }
.cn-search { position: relative; }
.cn-search .input { width: 100%; padding-left: 40px; font-size: 1rem; }
.cn-search svg.lucide { position: absolute; left: 13px; top: 50%; width: 18px; height: 18px; transform: translateY(-50%); color: var(--fg-muted); pointer-events: none; }
.cn-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
.cn-stat { background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--r-md); padding: 10px 12px; }
.cn-stat b { display: block; font-size: var(--fs-2xl); font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; }
.cn-stat span { font-size: var(--fs-xs); color: var(--fg-muted); }
.cn-grid { display: grid; grid-template-columns: 1fr; gap: var(--gap); align-items: start; }
.cn-card { position: relative; display: flex; flex-direction: column; gap: 8px; min-width: 0; text-align: left; font: inherit; color: inherit; width: 100%;
  background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-md); padding: 14px; }
button.cn-card { cursor: pointer; min-height: 44px; transition: border-color .15s, transform .15s; }
@media (hover: hover) { button.cn-card:hover { border-color: var(--border-strong); } }
button.cn-card:active { transform: scale(0.99); }
button.cn-card:focus-visible { outline: 2px solid var(--fg); outline-offset: 2px; }
.cn-card.is-off { opacity: .6; }
.cn-card.is-ink { background: var(--ink); color: var(--on-ink); border-color: var(--ink); }
.cn-card.is-ink .pill { border-color: var(--on-ink); color: var(--on-ink); }
.cn-head { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
.cn-head .cn-end { margin-left: auto; }
.cn-title { font-size: var(--fs-lg); font-weight: 800; letter-spacing: -0.01em; line-height: 1.25; overflow-wrap: anywhere; }
.cn-body { color: var(--fg-muted); white-space: pre-line; overflow-wrap: anywhere; }
.cn-card.is-ink .cn-body { color: inherit; opacity: .85; }
.cn-clamp { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
.cn-meta { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; font-size: var(--fs-xs); color: var(--fg-muted); }
.cn-meta svg.lucide { width: 14px; height: 14px; }
.cn-video { display: flex; align-items: center; justify-content: center; aspect-ratio: 16 / 9; border-radius: var(--r-sm, 10px); background: var(--surface-2); border: 1px solid var(--border); }
.cn-video svg.lucide { width: 36px; height: 36px; }
.cn-card .btn { align-self: flex-start; min-height: 44px; }
@media (min-width: 768px) {
  .cn-tools { flex-direction: row; align-items: center; justify-content: space-between; }
  .cn-search { flex: 0 1 320px; }
  .cn-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .cn-card { padding: 16px; }
}
@media (min-width: 1200px) { .cn-grid.cn-grid-admin { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
.dot { width: 8px; height: 8px; border-radius: 50%; background: var(--fg); flex-shrink: 0; }
.dot.ring { background: transparent; box-shadow: inset 0 0 0 2px var(--fg); }
.dot.pulse { animation: pulse 1.8s var(--ease) infinite; }

/* ── Avatar ──────────────────────────────────────────────────────────────── */
.avatar {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: var(--surface-3);
  color: var(--fg);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: var(--fs-md);
  letter-spacing: -0.02em;
  flex-shrink: 0;
  overflow: hidden;
  position: relative;
}
.avatar img { width: 100%; height: 100%; object-fit: cover; }
.avatar.sm { width: 34px; height: 34px; font-size: var(--fs-xs); }
.avatar.lg { width: 72px; height: 72px; font-size: var(--fs-2xl); }
.avatar.xl { width: 96px; height: 96px; font-size: var(--fs-3xl); }
.avatar.ink { background: var(--ink); color: var(--on-ink); }
.card-ink .avatar { background: color-mix(in srgb, var(--on-ink) 14%, transparent); color: var(--on-ink); }

/* ── Daftar ──────────────────────────────────────────────────────────────── */
.list { display: flex; flex-direction: column; gap: 8px; }
.list-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  border-radius: var(--r-md);
  background: var(--surface);
  border: 1px solid var(--border);
  transition: transform var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease), box-shadow var(--t-fast) var(--ease), background var(--t-fast) var(--ease);
  text-align: left;
  width: 100%;
}
@media (hover: hover) { .list-item.interactive:hover { border-color: var(--border-strong); box-shadow: var(--shadow-1); } }
.list-item.interactive:active { transform: scale(0.99); }
.list-item.selected { border-color: var(--fg); box-shadow: 0 0 0 1px var(--fg); }
.list-item.muted-item { background: var(--surface-2); border-style: dashed; }
.li-title { font-weight: 700; font-size: var(--fs-md); }
.li-sub { font-size: var(--fs-xs); color: var(--fg-muted); font-weight: 500; }
.li-trail { margin-left: auto; display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
.group-label { display: flex; align-items: center; gap: 12px; margin: 18px 2px 8px; }
.group-label span { font-size: var(--fs-2xs); font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg-muted); white-space: nowrap; }
.group-label::after { content: ''; height: 1px; flex: 1; background: var(--border); }

/* Meter sisa sesi */
.meter { height: 6px; border-radius: var(--r-full); background: var(--surface-3); overflow: hidden; }
.meter > i { display: block; height: 100%; border-radius: var(--r-full); background: var(--fg); width: 0; transition: width 900ms var(--ease-out); }
.meter.hatch > i { background: repeating-linear-gradient(135deg, var(--fg) 0 4px, transparent 4px 7px); }
.card-ink .meter { background: color-mix(in srgb, var(--on-ink) 16%, transparent); }
.card-ink .meter > i { background: var(--on-ink); }

/* ── Form ────────────────────────────────────────────────────────────────── */
.field { display: flex; flex-direction: column; gap: 6px; }
.label { font-size: var(--fs-xs); font-weight: 700; color: var(--fg-2); }
.hint { font-size: var(--fs-2xs); color: var(--fg-muted); }
.input, .select, .textarea {
  width: 100%;
  min-height: 48px;
  padding: 12px 14px;
  border-radius: var(--r-sm);
  border: 1.5px solid var(--border);
  background: var(--surface-2);
  color: var(--fg);
  font-size: 1rem;
  outline: none;
  transition: border-color var(--t-fast) var(--ease), background var(--t-fast) var(--ease), box-shadow var(--t-fast) var(--ease);
  -webkit-appearance: none;
  appearance: none;
}
.textarea { min-height: 88px; resize: vertical; }
.select {
  padding-right: 40px;
  background-image: linear-gradient(45deg, transparent 50%, var(--fg-muted) 50%), linear-gradient(135deg, var(--fg-muted) 50%, transparent 50%);
  background-position: calc(100% - 20px) 50%, calc(100% - 15px) 50%;
  background-size: 5px 5px;
  background-repeat: no-repeat;
}
.input::placeholder, .textarea::placeholder { color: var(--fg-muted); opacity: 0.8; }
@media (hover: hover) { .input:hover, .select:hover, .textarea:hover { border-color: var(--border-strong); } }
.input:focus, .select:focus, .textarea:focus { border-color: var(--fg); background: var(--surface); box-shadow: 0 0 0 4px color-mix(in srgb, var(--fg) 8%, transparent); }
.input-affix { display: flex; align-items: stretch; border-radius: var(--r-sm); border: 1.5px solid var(--border); background: var(--surface-2); transition: border-color var(--t-fast) var(--ease), box-shadow var(--t-fast) var(--ease), background var(--t-fast) var(--ease); }
.input-affix:focus-within { border-color: var(--fg); background: var(--surface); box-shadow: 0 0 0 4px color-mix(in srgb, var(--fg) 8%, transparent); }
.input-affix .affix { display: flex; align-items: center; padding: 0 4px 0 14px; font-weight: 700; color: var(--fg-muted); }
.input-affix .input { border: 0; background: transparent; box-shadow: none; }
.input-search { position: relative; }
.input-search svg.lucide { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--fg-muted); pointer-events: none; }
.input-search .input { padding-left: 42px; background: var(--surface); }
.input-search kbd { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); }
kbd { font-family: var(--font); font-size: .6875rem; font-weight: 700; color: var(--fg-muted); border: 1px solid var(--border); border-bottom-width: 2px; border-radius: 6px; padding: 1px 6px; background: var(--surface-2); }
.form-grid { display: grid; gap: 14px; grid-template-columns: minmax(0, 1fr); }
.form-grid .two { display: grid; gap: 12px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
.form-error { display: flex; align-items: center; gap: 8px; font-size: var(--fs-sm); font-weight: 700; padding: 10px 12px; border-radius: var(--r-sm); border: 1.5px solid var(--fg); background: var(--surface); }
.form-error::before { content: '!'; width: 18px; height: 18px; border-radius: 50%; background: var(--fg); color: var(--bg); font-size: .75rem; font-weight: 900; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
.toggle { position: relative; width: 46px; height: 28px; flex-shrink: 0; }
.toggle input { position: absolute; opacity: 0; inset: -8px -4px; margin: 0; cursor: pointer; z-index: 1; }   /* area sentuh 54 × 44 px, tampilan tetap 46 × 28 */
.toggle span { position: absolute; inset: 0; border-radius: var(--r-full); background: var(--surface-3); border: 1.5px solid var(--border-strong); transition: background var(--t-base) var(--ease); }
.toggle span::after { content: ''; position: absolute; top: 3px; left: 3px; width: 19px; height: 19px; border-radius: 50%; background: var(--surface); box-shadow: var(--shadow-1); transition: transform var(--t-base) var(--spring); }
.toggle input:checked + span { background: var(--ink); border-color: var(--ink); }
.toggle input:checked + span::after { transform: translateX(18px); background: var(--on-ink); }
.toggle input:focus-visible + span { outline: 2px solid var(--focus); outline-offset: 2px; }
.day-picker { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 6px; }
.recurring-day-btn { min-height: 40px; border-radius: 12px; border: 1.5px solid var(--border); background: var(--surface); font-weight: 800; font-size: var(--fs-xs); transition: all var(--t-fast) var(--ease); }
.recurring-day-btn.active { background: var(--ink); border-color: var(--ink); color: var(--on-ink); transform: translateY(-1px); }

/* Pemilih paket (dropdown dengan pencarian) */
.pkg-wrap { position: relative; }
.pkg-trigger { display: flex; align-items: center; justify-content: space-between; gap: 8px; text-align: left; }
.pkg-panel { position: absolute; left: 0; right: 0; top: calc(100% + 6px); z-index: 5; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-md); box-shadow: var(--shadow-3); overflow: hidden; animation: scaleIn var(--t-base) var(--ease-out); transform-origin: top; }
.pkg-panel .pkg-search { padding: 10px; border-bottom: 1px solid var(--border); }
.pkg-list { max-height: 240px; overflow-y: auto; }
.pkg-option { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 14px; text-align: left; transition: background var(--t-fast) var(--ease); }
.pkg-option:focus-visible { background: var(--surface-2); }
@media (hover: hover) { .pkg-option:hover { background: var(--surface-2); } }

/* ── Segmented control ──────────────────────────────────────────────────── */
.seg { position: relative; display: inline-grid; grid-auto-flow: column; grid-auto-columns: 1fr; padding: 4px; border-radius: 14px; background: var(--surface-3); isolation: isolate; }
.seg button { position: relative; z-index: 1; min-height: 44px; padding: 0 16px; border-radius: 10px; font-weight: 700; font-size: var(--fs-sm); color: var(--fg-muted); transition: color var(--t-base) var(--ease); }
.seg button.active { color: var(--fg); }
.seg .seg-thumb { position: absolute; z-index: 0; top: 4px; bottom: 4px; left: 4px; border-radius: 10px; background: var(--surface); box-shadow: var(--shadow-1); transition: transform var(--t-base) var(--ease-out), width var(--t-base) var(--ease-out); }
.seg.ink { background: var(--ink); }
.seg.ink button { color: var(--on-ink-muted); }
.seg.ink button.active { color: var(--ink); }
.seg.ink .seg-thumb { background: var(--on-ink); }

/* ── Kalender bulan (kartu hitam) ───────────────────────────────────────── */
.month-cal { background: var(--ink); color: var(--on-ink); border-radius: var(--r-xl); padding: 18px 16px 16px; box-shadow: var(--shadow-2); user-select: none; }
.month-cal .mc-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
.month-cal .mc-title { font-weight: 800; font-size: var(--fs-lg); letter-spacing: -0.01em; }
.month-cal .mc-nav { width: 44px; height: 44px; border-radius: 12px; color: var(--on-ink); display: inline-flex; align-items: center; justify-content: center; transition: background var(--t-fast) var(--ease), transform var(--t-fast) var(--ease); }
@media (hover: hover) { .month-cal .mc-nav:hover { background: color-mix(in srgb, var(--on-ink) 12%, transparent); } }
.month-cal .mc-nav:active { transform: scale(0.9); }
.month-cal .mc-today { font-size: var(--fs-2xs); font-weight: 800; padding: 6px 10px; border-radius: var(--r-full); border: 1px solid color-mix(in srgb, var(--on-ink) 30%, transparent); color: var(--on-ink); }
.month-cal .mc-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 2px; }
.month-cal .mc-dow { text-align: center; font-size: .625rem; font-weight: 800; letter-spacing: 0.08em; color: var(--on-ink-muted); padding: 4px 0 8px; }
.month-cal .mc-day {
  position: relative;
  aspect-ratio: 1 / 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14px;
  font-weight: 700;
  font-size: var(--fs-sm);
  color: var(--on-ink);
  transition: background var(--t-fast) var(--ease), color var(--t-fast) var(--ease), transform var(--t-base) var(--spring);
}
@media (hover: hover) { .month-cal .mc-day:hover { background: color-mix(in srgb, var(--on-ink) 10%, transparent); } }
.month-cal .mc-day.out { color: color-mix(in srgb, var(--on-ink) 28%, transparent); }
.month-cal .mc-day.past { color: color-mix(in srgb, var(--on-ink) 55%, transparent); }
.month-cal .mc-day.today::before { content: ''; position: absolute; bottom: 6px; width: 14px; height: 2px; border-radius: 2px; background: var(--on-ink); }
.month-cal .mc-day.selected { background: var(--on-ink); color: var(--ink); transform: scale(1.06); }
.month-cal .mc-day.selected::before { background: var(--ink); }
.month-cal .mc-day .mc-dots { position: absolute; top: 6px; right: 6px; display: flex; gap: 2px; }
.month-cal .mc-day .mc-dots i { width: 5px; height: 5px; border-radius: 50%; background: var(--on-ink); }
.month-cal .mc-day .mc-dots i.ring { background: transparent; box-shadow: inset 0 0 0 1.5px var(--on-ink); }
.month-cal .mc-day.selected .mc-dots i { background: var(--ink); }
.month-cal .mc-day.selected .mc-dots i.ring { background: transparent; box-shadow: inset 0 0 0 1.5px var(--ink); }
.month-cal .mc-legend { display: flex; gap: 14px; margin-top: 12px; font-size: var(--fs-2xs); color: var(--on-ink-muted); font-weight: 600; }
.month-cal .mc-legend span { display: inline-flex; align-items: center; gap: 6px; }
.month-cal .mc-legend i { width: 6px; height: 6px; border-radius: 50%; background: var(--on-ink); }
.month-cal .mc-legend i.ring { background: transparent; box-shadow: inset 0 0 0 1.5px var(--on-ink); }
.mc-grid.anim-next { animation: slideInR var(--t-base) var(--ease-out); }
.mc-grid.anim-prev { animation: slideInL var(--t-base) var(--ease-out); }

/* Strip tanggal (HP) */
.date-strip { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; padding: 2px; scroll-snap-type: x mandatory; }
.date-strip::-webkit-scrollbar { display: none; }
.ds-day { scroll-snap-align: center; flex-shrink: 0; width: 52px; min-height: 72px; border-radius: 18px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; background: var(--surface); border: 1px solid var(--border); font-weight: 800; transition: all var(--t-base) var(--ease-out); }
.ds-day small { font-size: .625rem; font-weight: 700; color: var(--fg-muted); text-transform: uppercase; letter-spacing: 0.04em; }
.ds-day.selected { background: var(--ink); color: var(--on-ink); border-color: var(--ink); transform: translateY(-2px); }
.ds-day.selected small { color: var(--on-ink-muted); }

/* ── Timeline sesi ──────────────────────────────────────────────────────── */
.timeline { position: relative; display: flex; flex-direction: column; gap: 10px; }
.tl-item { position: relative; display: grid; grid-template-columns: 54px 18px minmax(0, 1fr); align-items: stretch; gap: 8px; }
.tl-time { font-weight: 800; font-size: var(--fs-sm); padding-top: 14px; text-align: right; font-variant-numeric: tabular-nums; }
.tl-time small { display: block; font-size: var(--fs-2xs); font-weight: 600; color: var(--fg-muted); }
.tl-rail { position: relative; display: flex; justify-content: center; }
.tl-rail::before { content: ''; position: absolute; top: 0; bottom: -10px; width: 2px; background: var(--border); }
.tl-item:last-child .tl-rail::before { bottom: 50%; }
.tl-rail .tl-node { position: relative; margin-top: 16px; width: 12px; height: 12px; border-radius: 50%; background: var(--surface); box-shadow: 0 0 0 2px var(--fg); }
.tl-item.now .tl-node, .tl-item.new .tl-node { background: var(--fg); }
.tl-item.done .tl-node { background: var(--fg-muted); box-shadow: 0 0 0 2px var(--fg-muted); }
.tl-card { border-radius: var(--r-md); padding: 12px 14px; background: var(--surface); border: 1px solid var(--border); display: flex; flex-direction: column; gap: 8px; min-width: 0; transition: border-color var(--t-fast) var(--ease), box-shadow var(--t-fast) var(--ease), transform var(--t-fast) var(--ease); }
@media (hover: hover) { .tl-card.interactive:hover { border-color: var(--border-strong); box-shadow: var(--shadow-1); } }
.tl-item.now .tl-card, .tl-card.ink { background: var(--ink); color: var(--on-ink); border-color: var(--ink); }
.tl-item.now .tl-card .li-sub, .tl-card.ink .li-sub { color: var(--on-ink-muted); }
.tl-item.now .tl-card .pill { border-color: var(--on-ink); color: var(--on-ink); }
.tl-item.done .tl-card { background: var(--surface-2); color: var(--fg-muted); }
.tl-item.hold .tl-card { border-style: dashed; border-width: 1.5px; border-color: var(--fg-muted); }
.tl-item.available .tl-card { border-style: dashed; background: transparent; }
.sess-actions { display: flex; gap: 6px; flex-wrap: wrap; }
.sess-actions .btn { min-height: 44px; padding: 0 12px; font-size: var(--fs-xs); border-radius: 10px; }
.sess-actions .btn-primary { order: -1; }
@media (min-width: 768px) { .sess-actions { justify-content: flex-end; } }
.tl-item.now .btn-secondary { background: color-mix(in srgb, var(--on-ink) 14%, transparent); color: var(--on-ink); }
.tl-item.now .btn-outline { border-color: color-mix(in srgb, var(--on-ink) 40%, transparent); color: var(--on-ink); }

/* Slot waktu (portal) */
.slot-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(88px, 1fr)); gap: 8px; }
.slot { min-height: 46px; border-radius: 14px; border: 1.5px dashed var(--border-strong); background: transparent; font-weight: 800; font-size: var(--fs-sm); font-variant-numeric: tabular-nums; display: flex; align-items: center; justify-content: center; gap: 6px; transition: all var(--t-fast) var(--ease); }
@media (hover: hover) { .slot:hover:not(:disabled) { border-style: solid; border-color: var(--fg); transform: translateY(-1px); } }
.slot:active:not(:disabled) { transform: scale(0.96); }
.slot.taken { border-style: solid; border-color: var(--border); background: var(--surface-3); color: var(--fg-muted); cursor: not-allowed; text-decoration: line-through; }
.slot.mine { background: var(--ink); color: var(--on-ink); border: 1.5px solid var(--ink); cursor: default; }
.slot.past { opacity: 0.4; cursor: not-allowed; }
.slot.active { border-style: solid; border-color: var(--ink); background: var(--ink); color: var(--on-ink); }
/* Bentrok booking di sheet (portal): notice + saran jam + tombol, semua ≥ 44 px dan boleh turun baris */
.conflict-panel { flex-direction: column; align-items: stretch; gap: 12px; }
.conflict-panel .slot { height: auto; min-height: 44px; padding: 6px 8px; line-height: 1.2; text-align: center; }
.conflict-panel .btn { white-space: normal; line-height: 1.25; text-align: center; padding-top: 10px; padding-bottom: 10px; }

/* ── Grafik (monokrom) ──────────────────────────────────────────────────── */
.bars { display: flex; align-items: flex-end; gap: 10px; height: 140px; padding-top: 18px; }
.bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8px; height: 100%; min-width: 0; position: relative; }
.bar-track { flex: 1; width: 100%; display: flex; align-items: flex-end; justify-content: center; position: relative; }
.bar { width: 100%; max-width: 24px; height: 0; border-radius: 6px 6px 2px 2px; background: var(--fg); transition: height 900ms var(--ease-out); position: relative; }
.bar.soft { background: var(--border-strong); }
.bar-val { position: absolute; bottom: calc(100% + 4px); left: 50%; transform: translateX(-50%); font-size: var(--fs-2xs); font-weight: 800; white-space: nowrap; opacity: 0; transition: opacity var(--t-base) var(--ease) 500ms; }
.bars.ready .bar-val { opacity: 1; }
.bar-lbl { font-size: var(--fs-2xs); font-weight: 700; color: var(--fg-muted); text-transform: uppercase; }
.bar-col.today .bar-lbl { color: var(--fg); }
.hbar { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 12px; align-items: center; }
.hbar .hbar-track { grid-column: 1 / -1; height: 8px; border-radius: var(--r-full); background: var(--surface-3); overflow: hidden; }
.hbar .hbar-track i { display: block; height: 100%; width: 0; border-radius: 0 4px 4px 0; background: var(--fg); transition: width 900ms var(--ease-out); }
.ring-wrap { position: relative; width: 132px; height: 132px; flex-shrink: 0; }
.ring-wrap svg { width: 100%; height: 100%; transform: rotate(-90deg); }
.ring-wrap .ring-track { stroke: var(--surface-3); }
.ring-wrap .ring-fill { stroke: var(--fg); transition: stroke-dashoffset 1200ms var(--ease-out); }
.ring-wrap .ring-center { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.card-ink .ring-wrap .ring-track { stroke: color-mix(in srgb, var(--on-ink) 16%, transparent); }
.card-ink .ring-wrap .ring-fill { stroke: var(--on-ink); }
.heat { display: grid; gap: 3px; }
.heat-cell { aspect-ratio: 1 / 1; border-radius: 4px; background: var(--heat-0); transition: transform var(--t-fast) var(--ease); }
@media (hover: hover) { .heat-cell:hover { transform: scale(1.25); position: relative; z-index: 1; } }
.heat-cell.l1 { background: var(--heat-1); }
.heat-cell.l2 { background: var(--heat-2); }
.heat-cell.l3 { background: var(--heat-3); }
.heat-cell.l4 { background: var(--heat-4); }
.heat-cell.none { background: transparent; }
.heat-lbl { font-size: .625rem; font-weight: 700; color: var(--fg-muted); display: flex; align-items: center; }
.heat-legend { display: flex; align-items: center; gap: 4px; font-size: var(--fs-2xs); color: var(--fg-muted); font-weight: 600; }
.heat-legend .heat-cell { width: 12px; height: 12px; }
.tooltip { position: fixed; z-index: 200; pointer-events: none; background: var(--ink); color: var(--on-ink); font-size: var(--fs-xs); font-weight: 700; padding: 6px 10px; border-radius: 10px; box-shadow: var(--shadow-2); opacity: 0; transform: translate(-50%, calc(-100% - 10px)) scale(0.96); transition: opacity var(--t-fast) var(--ease), transform var(--t-fast) var(--ease); white-space: nowrap; }
.tooltip.show { opacity: 1; transform: translate(-50%, calc(-100% - 10px)) scale(1); }
.collapse-head { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 12px; text-align: left; }
.collapse-head svg.lucide { transition: transform var(--t-base) var(--ease); }
.collapse.closed .collapse-head svg.lucide.chev { transform: rotate(-90deg); }
.collapse-body { display: grid; grid-template-rows: 1fr; transition: grid-template-rows var(--t-slow) var(--ease-out), opacity var(--t-base) var(--ease); }
.collapse-body > div { overflow: hidden; min-height: 0; }
.collapse.closed .collapse-body { grid-template-rows: 0fr; opacity: 0; }

