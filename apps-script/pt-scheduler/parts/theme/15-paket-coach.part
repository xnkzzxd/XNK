/* Fase AF: paket coach (kartu Paket Anda, menu terkunci, lembar Tersedia di Pro) */
.plan-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.plan-tier { font-weight: 800; font-size: var(--fs-lg, 1.1rem); }
.plan-m { display: grid; gap: 6px; }
.plan-mh { display: flex; justify-content: space-between; gap: 12px; font-size: var(--fs-sm); color: var(--fg-muted); }
.plan-mh b { color: var(--fg); font-variant-numeric: tabular-nums; }
.plan-bar { height: 8px; border-radius: 999px; background: color-mix(in srgb, var(--fg) 10%, transparent); overflow: hidden; }
.plan-bar i { display: block; height: 100%; border-radius: inherit; background: var(--fg); }
.plan-bar.full i { background: var(--danger); }
.plan-warn { display: flex; gap: 8px; align-items: flex-start; margin: 0; padding: 10px 12px; border-radius: 12px; background: color-mix(in srgb, var(--fg) 6%, transparent); font-size: var(--fs-sm); }
.plan-warn svg { flex: none; width: 18px; height: 18px; margin-top: 1px; }
.nav-item.nav-locked { color: var(--fg-muted); opacity: .6; }
.plan-pill { margin-left: auto; padding: 1px 8px; border-radius: 999px; border: 1px solid currentColor; font-size: .7rem; font-weight: 700; line-height: 1.5; }
.cp-tab.tab-locked { opacity: .5; }
</style>
