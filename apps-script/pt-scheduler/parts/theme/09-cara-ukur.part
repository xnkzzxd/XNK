/* ═══ Fase AC (T-2303): tombol ? di samping label ukuran + lembar cara mengukur (#sheet-ukur) ═══ */
.lbl-help { display: flex; align-items: center; justify-content: space-between; gap: 4px; min-width: 0; }
.lbl-help .label { min-width: 0; }
.help-btn { flex: none; display: inline-grid; place-items: center; width: 44px; height: 44px; margin: -12px -10px -12px 0; padding: 0; border: 0; border-radius: 999px;
  background: none; color: var(--fg-muted); cursor: pointer; }
.help-btn svg { width: 18px; height: 18px; }
@media (hover: hover) { .help-btn:hover { color: var(--fg); } }
.help-btn:focus-visible { outline: 2px solid var(--fg); outline-offset: -8px; }
.uk-chips { margin: 0 0 14px; }
.uk-wrap { display: grid; gap: 16px; }
.uk-fig { display: flex; justify-content: center; }
.uk-svg { width: min(170px, 44vw); height: auto; }
.uk-svg .ukb { fill: color-mix(in srgb, var(--fg) 8%, transparent); stroke: color-mix(in srgb, var(--fg) 50%, transparent); stroke-width: 4; }
.uk-svg .ukl { stroke: var(--fg); stroke-width: 12; stroke-dasharray: 26 16; stroke-linecap: round; }
.uk-skel { display: block; width: min(170px, 44vw); aspect-ratio: 1 / 2; border-radius: 16px; }
.uk-scale { display: grid; place-items: center; width: 120px; height: 120px; border-radius: 24px; background: color-mix(in srgb, var(--fg) 8%, transparent); }
.uk-scale svg { width: 56px; height: 56px; }
.uk-steps { margin: 0; padding-left: 1.25rem; display: grid; gap: 8px; line-height: 1.45; }
.uk-umum { padding: 12px 14px; border-radius: 14px; background: color-mix(in srgb, var(--fg) 5%, transparent); }
.uk-umum .uk-steps { font-size: var(--fs-sm); color: var(--fg-2); margin-top: 6px; }
@media (min-width: 600px) { .uk-wrap { grid-template-columns: 190px minmax(0, 1fr); align-items: start; } }
</style>
