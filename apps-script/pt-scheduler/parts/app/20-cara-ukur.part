  // ═══ Fase AC (T-2303): cara mengukur ukuran tubuh ═══
  // Tombol ? di samping tiap ukuran (lembar catat klien/coach, assessment) membuka #sheet-ukur: figur depan sendiri
  // (figure/figure.min.json, pria/wanita) dengan garis pita di tinggi yang benar, 3 langkah singkat dan aturan umum.
  // Sumber tiap langkah: docs/coachkit/Sumber.md (U01–U08). Tanpa panggilan server; figur dimuat malas seperti peta otot.
  // Garis pita: [tinggi %, x kiri %, x kanan %] dari viewBox figur depan (724 × 1448). Kanan klien = sisi kiri gambar.
  const UKUR_LINE = {
    m: { dada: [30, 31, 69], lengan: [37, 18, 30], pinggang: [41, 32, 68], perut: [44, 32, 68], pinggul: [49.5, 31, 69], paha: [56, 32, 49] },
    f: { dada: [29, 31, 55], lengan: [36, 14, 26], pinggang: [40, 31, 56], perut: [44, 29, 58], pinggul: [50, 25, 62], paha: [56, 26, 43] }
  };
  // Sumbu tengah figur (x %) untuk mencerminkan sisi kiri; figur wanita lebih sempit dari viewBox.
  const UKUR_MID = { m: 50, f: 44 };
  const UKUR_STEPS = {
    berat: ['Timbang pagi hari setelah ke kamar kecil, sebelum makan dan minum.', 'Pakai baju tipis, tanpa alas kaki.', 'Pakai timbangan yang sama, di lantai yang rata dan keras.'],
    pinggang: ['Berdiri tegak, perut rileks, lengan di samping badan.', 'Cari tulang rusuk paling bawah dan puncak tulang pinggul; lingkarkan pita tepat di tengah keduanya.', 'Baca angkanya di akhir napas keluar yang biasa.'],
    perut: ['Berdiri tegak, perut rileks.', 'Lingkarkan pita tepat setinggi pusar.', 'Baca di akhir napas keluar yang biasa, tanpa menahan atau mengempiskan perut.'],
    pinggul: ['Berdiri tegak, kedua kaki rapat, lengan di samping badan.', 'Lingkarkan pita di bagian bokong yang paling menonjol (paling lebar).', 'Lihat cermin dari samping supaya pita lurus mendatar.'],
    dada: ['Berdiri tegak, lengan rileks di samping badan.', 'Lingkarkan pita di tengah dada, lewat bawah ketiak, setinggi puting.', 'Baca di akhir napas keluar yang biasa.'],
    lengan: ['Biarkan lengan tergantung rileks di samping badan.', 'Cari titik tengah antara ujung bahu dan siku; lingkarkan pita di situ.', 'Pita mendatar, tidak mengikuti lekuk otot.'],
    paha: ['Berdiri tegak, berat badan di kedua kaki, kaki sedikit terbuka.', 'Lingkarkan pita sekitar 1 cm di bawah lipatan bokong.', 'Pita mendatar dan tidak menekan kulit.']
  };
  const UKUR_UMUM = ['Ukur di waktu yang sama, sebaiknya pagi sebelum makan.', 'Pita menempel di kulit, kencang tetapi tidak menekan.', 'Ukur dua kali dan pakai rata-ratanya.', 'Selalu sisi yang sama, dan bila bisa oleh orang yang sama.'];
  // Kunci form → [kunci, nama, garis, sisi]. Sisi 'kiri' = cermin dari sisi kanan.
  const UKUR_KEYS = [['berat', 'Berat', '', ''], ['pinggang', 'Pinggang', 'pinggang', ''], ['perut', 'Perut', 'perut', ''], ['pinggul', 'Pinggul', 'pinggul', ''],
    ['dada', 'Dada', 'dada', ''], ['lenganKanan', 'Lengan kanan', 'lengan', 'kanan'], ['lenganKiri', 'Lengan kiri', 'lengan', 'kiri'],
    ['pahaKanan', 'Paha kanan', 'paha', 'kanan'], ['pahaKiri', 'Paha kiri', 'paha', 'kiri']];
  window.UKUR_KEYS = UKUR_KEYS.map(x => x[0]);
  const ukurDef = k => UKUR_KEYS.find(x => x[0] === k) || UKUR_KEYS[0];
  const ukur = { key: 'pinggang', sex: 'm' };
  /** Figur depan + garis pita (SVG). null bila figur belum ada di perangkat. */
  function ukurFigSvg(key, sex) {
    const f = figSync(), v = f && f.views && (f.views[sex] || f.views.m);
    if (!v || !v.front) return null;
    const s = f.views[sex] ? sex : 'm', d = ukurDef(key), L = d[2] ? UKUR_LINE[s][d[2]] : null;
    let tape = '';
    if (L) {
      let x1 = L[1], x2 = L[2];
      if (d[3] === 'kiri') { const mid = UKUR_MID[s]; x1 = 2 * mid - L[2]; x2 = 2 * mid - L[1]; }
      const y = (L[0] * 14.48).toFixed(1);
      tape = '<line class="ukl" x1="' + (x1 * 7.24).toFixed(1) + '" x2="' + (x2 * 7.24).toFixed(1) + '" y1="' + y + '" y2="' + y + '"/>';
    }
    return '<svg class="uk-svg" viewBox="' + h(v.front.vb) + '" role="img" aria-label="' + h('Letak pita: ' + d[1]) + '"><path class="ukb" d="' + v.front.outline + '"/>' + tape + '</svg>';
  }
  window.ukurFigSvg = ukurFigSvg;
  function ukurRender() {
    const d = ukurDef(ukur.key), steps = UKUR_STEPS[d[2] || 'berat'];
    const fig = d[2] ? ukurFigSvg(ukur.key, ukur.sex) : '<span class="uk-scale" aria-hidden="true">' + icon('scale') + '</span>';
    if (!fig) figEnsure().then(function (x) { const el = $('sheet-ukur'); if (x && el && !el.classList.contains('hide')) ukurRender(); });
    $('uk-title').textContent = 'Cara mengukur ' + d[1].toLowerCase();
    setHTML('uk-body',
      '<div class="chips uk-chips" role="tablist" aria-label="Pilih ukuran">' + UKUR_KEYS.map(function (x) {
        const on = x[0] === ukur.key;
        return '<button type="button" role="tab" class="chip' + (on ? ' active' : '') + '" aria-selected="' + on + '" onclick="window.ukurPick(\'' + x[0] + '\')">' + h(x[1]) + '</button>';
      }).join('') + '</div>' +
      '<div class="uk-wrap"><div class="uk-fig">' + (fig || '<span class="skel uk-skel"></span>') + '</div>' +
      '<div class="stack" style="gap:12px"><ol class="uk-steps">' + steps.map(function (t) { return '<li>' + h(t) + '</li>'; }).join('') + '</ol>' +
      (d[3] ? '<p class="hint">Ukur sisi ' + d[3] + ' setiap kali, supaya angkanya bisa dibandingkan.</p>' : '') +
      '<div class="uk-umum"><p class="eyebrow">Supaya angka bisa dibandingkan</p><ul class="uk-steps">' + UKUR_UMUM.map(function (t) { return '<li>' + h(t) + '</li>'; }).join('') + '</ul></div>' +
      '<p class="li-sub uk-src">Cara ukur mengikuti panduan WHO (pinggang, pinggul) dan ISAK (lengan, dada, paha).</p></div></div>');
    ukurChipIntoView();
  }
  // Chip terpilih ke tengah baris chip (hanya geser mendatar; isi sheet tidak ikut bergulir).
  function ukurChipIntoView() {
    const row = document.querySelector('#uk-body .uk-chips'), act = row && row.querySelector('.active');
    if (act && row.clientWidth) row.scrollLeft = Math.max(0, act.offsetLeft - row.offsetLeft - (row.clientWidth - act.offsetWidth) / 2);
  }
  window.ukurPick = function (k) { ukur.key = ukurDef(k)[0]; ukurRender(); };
  /** Buka panduan untuk satu ukuran. Lembar yang sedang terbuka (catat / assessment) kembali saat panduan ditutup. */
  window.ukurOpen = function (key) {
    const layer = $('sheet-layer');
    const open = layer && !layer.classList.contains('hide') ? layer.querySelector(':scope > .sheet:not(.hide)') : null;
    let sex = 'm';
    try {
      if (open && open.id === 'modal-care-assess') sex = figSexOf('admin', careMember);
      else if (open && open.id === 'sheet-progress') sex = pg.mode === 'admin' ? figSexOf('admin', pg.memberId) : figSexOf('client');
      else if (window.myNutrition) sex = figSexOf('client');
    } catch (e) {}
    ukur.key = ukurDef(key)[0]; ukur.sex = sex;
    ukurRender();
    if (open && open.id !== 'sheet-ukur') ui.sheetReturn = open.id;
    openSheet('sheet-ukur');
    setTimeout(ukurChipIntoView, 60);
  };
})();
</script>