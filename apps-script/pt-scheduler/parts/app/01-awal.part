<script>
/* =============================================================================
   XNK Personal Training — aplikasi panel PT & portal klien (hanya Index.html).
   Landing TIDAK memuat file ini. Helper bersama (escapeHtml, sanitizePhone,
   formatRp, _lsGet/_lsSet, ADMIN_TOKEN_KEY, MEMBER_TOKEN_KEY) ada di Scripts.html.
   Semua yang dipanggil dari HTML (onclick) diekspos di window.*.
   ============================================================================= */
(function () {
  'use strict';

  // ── State ───────────────────────────────────────────────────────────────────
  window.members = [];
  window.taskSummary = {}; // {memberId:{open,overdue}} dari getTaskSummary (panel PT)
  window.memberArchive = [];
  window.schedules = [];
  window.coaches = [];
  // Mode solo: tepat satu coach aktif. window.coaches hanya berisi coach aktif, jadi cukup dihitung.
  window.isSoloCoach = function () { return (window.coaches || []).length === 1; };
  window.priceListData = [];
  window.currentView = null;
  window.isPublicView = false;
  window.publicLoggedMember = null;
  window.selectedMemberId = null;
  window.selectedScheduleDetailId = null;
  window.currentClientType = null;
  window.isEditScheduleMode = false;
  window.isRescheduleMode = false;
  window.rescheduleScheduleId = null;

  const today0 = () => { const d = new Date(); d.setHours(0, 0, 0, 0); return d; };
  const ui = {
    mode: 'admin',
    calMonth: (() => { const d = today0(); d.setDate(1); return d; })(),
    selectedDate: today0(),
    coachFilter: 'ALL',
    bookCoach: '',   // klien: coach yang dipilih untuk booking (wajib kalau ada 2 coach aktif atau lebih)
    schedMode: 'month',
    clientFilter: 'all',
    clientQuery: '',
    clientSort: 'terbaru',   // terbaru | perhatian | nama | sisa | lama (disimpan di perangkat ini)
    clientView: 'card',      // card | list (PC)
    statsMonth: null,
    detail: null,
    revenue: null,
    lastFocus: null,
    bookingMemberId: null,
    dataReady: false,
    cpTab: null,       // tab halaman klien terakhir {id, name}: bertahan saat data diperbarui
    wideTimer: 0,      // PC: lepas #app.detail-wide setelah panel selesai menutup
    revealTimer: 0
  };

  const MONTHS = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
  const DOW_SHORT = ['Min', 'Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab'];
  const COACH_WA_NUMBER = '6288221254305';

  // ── Util ────────────────────────────────────────────────────────────────────
  const h = escapeHtml;
  const $ = id => document.getElementById(id);
  const icon = (name, attrs) => '<i data-lucide="' + name + '"' + (attrs ? ' ' + attrs : '') + '></i>';
  const pad = n => String(n).padStart(2, '0');
  const ymd = d => d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
  const hm = d => pad(d.getHours()) + ':' + pad(d.getMinutes());
  // Portal klien: semua jam dibaca & ditulis dalam WIB (UTC+7), apa pun zona waktu HP.
  const wibAt = (date, time) => new Date(date + 'T' + time + ':00+07:00');
  const wibParts = d => { const w = new Date(d.getTime() + 7 * 3600000); return { date: w.getUTCFullYear() + '-' + pad(w.getUTCMonth() + 1) + '-' + pad(w.getUTCDate()), hour: w.getUTCHours(), min: w.getUTCMinutes() }; };
  const sameDay = (a, b) => a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth() && a.getDate() === b.getDate();
  const fmtTime = d => pad(d.getHours()) + '.' + pad(d.getMinutes());
  const fmtDate = (d, o) => d.toLocaleDateString('id-ID', o || { weekday: 'long', day: 'numeric', month: 'long' });
  const fmtShort = d => d.toLocaleDateString('id-ID', { weekday: 'short', day: 'numeric', month: 'short' });
  const status = s => String((s && s.status) || '').toLowerCase();
  const isAvailable = s => status(s) === 'available';
  const isDone = s => status(s) === 'completed';
  const isBooked = s => !isAvailable(s);
  const byStart = (a, b) => new Date(a.start) - new Date(b.start);
  const remainingOf = m => Math.max(0, (Number(m.totalSessions) || 0) - (Number(m.usedSessions) || 0));

  function initials(name) {
    const parts = String(name || '?').trim().split(/\s+/).filter(Boolean);
    return ((parts[0] || '?')[0] + (parts.length > 1 ? parts[parts.length - 1][0] : '')).toUpperCase();
  }

  function avatar(photo, name, cls, style) {
    const ini = h(initials(name));
    const attrs = 'class="avatar' + (cls ? ' ' + cls : '') + '"' + (style ? ' style="' + style + '"' : '');
    if (photo) {
      return '<span ' + attrs + ' data-ini="' + ini + '"><img src="' + h(photo) + '" alt="" loading="lazy" ' +
        'onerror="this.parentNode.textContent=this.parentNode.getAttribute(\'data-ini\')"></span>';
    }
    return '<span ' + attrs + '>' + ini + '</span>';
  }

  window.parseFlexibleDate = function (str) {
    if (!str) return new Date(0);
    if (str instanceof Date) return str;
    const parts = String(str).split('/');
    if (parts.length === 3) {
      const d = new Date(parseInt(parts[2], 10), parseInt(parts[1], 10) - 1, parseInt(parts[0], 10));
      if (!isNaN(d)) return d;
    }
    const f = new Date(str);
    return isNaN(f) ? new Date(0) : f;
  };

  function timeUntil(date) {
    const diff = date - new Date();
    if (diff <= 0) return 'Berlangsung';
    const mins = Math.round(diff / 60000);
    if (mins < 60) return mins + ' mnt lagi';
    const hrs = Math.floor(mins / 60);
    if (hrs < 24) return hrs + ' jam ' + (mins % 60 ? (mins % 60) + ' mnt ' : '') + 'lagi';
    return Math.floor(hrs / 24) + ' hari lagi';
  }

  function countdownText(date) {
    const diff = date - Date.now();
    if (diff <= 0) return 'Sesi sedang berlangsung';
    const d = Math.floor(diff / 86400000);
    const hh = Math.floor((diff % 86400000) / 3600000);
    const mm = Math.floor((diff % 3600000) / 60000);
    const ss = Math.floor((diff % 60000) / 1000);
    return d > 0 ? d + ' hari ' + hh + ' jam lagi' : pad(hh) + ':' + pad(mm) + ':' + pad(ss);
  }

  function greeting() {
    const hr = new Date().getHours();
    if (hr < 11) return 'Selamat pagi';
    if (hr < 15) return 'Selamat siang';
    if (hr < 18) return 'Selamat sore';
    return 'Selamat malam';
  }

  // Ikon lucide digambar setelah DOM berubah (debounce), HANYA <i data-lucide> yang belum digambar.
  // lucide.createIcons() menggambar ulang SEMUA ikon (svg hasilnya tetap punya data-lucide); bersama MutationObserver
  // (bagian 14) itu jadi putaran tanpa henti, ±46 kali per detik, yang membuat HP panas (2026-11-20). Jangan panggil langsung.
  let iconTimer = null;
  function iconPascal(name) {
    return String(name).split(/[-_\s]+/).filter(Boolean).map(function (p) { return p.charAt(0).toUpperCase() + p.slice(1); }).join('');
  }
  function drawIcons() {
    const L = window.lucide;
    if (!L) return;
    const todo = document.querySelectorAll('i[data-lucide]');
    if (!todo.length) return;
    if (typeof L.createElement !== 'function' || !L.icons) { L.createIcons(); return; }
    for (let i = 0; i < todo.length; i++) {
      const el = todo[i], name = el.getAttribute('data-lucide'), node = L.icons[iconPascal(name)];
      if (!node || !el.parentNode) continue;
      // Sama dengan replaceElement lucide: atribut elemen ikut, aria-hidden bila tanpa label, kelas lucide lucide-<nama>.
      const attrs = { 'data-lucide': name };
      let labelled = false;
      for (let k = 0; k < el.attributes.length; k++) {
        const at = el.attributes[k];
        attrs[at.name] = at.value;
        if (at.name.indexOf('aria-') === 0 || at.name === 'role' || at.name === 'title') labelled = true;
      }
      if (!labelled) attrs['aria-hidden'] = 'true';
      attrs['class'] = ['lucide', 'lucide-' + name].concat((el.getAttribute('class') || '').split(/\s+/))
        .filter(function (c, ix, arr) { return c && arr.indexOf(c) === ix; }).join(' ');
      el.parentNode.replaceChild(L.createElement(node, attrs), el);
    }
  }
  function paintIcons() {
    clearTimeout(iconTimer);
    iconTimer = setTimeout(function () { try { drawIcons(); } catch (e) {} }, 16);
  }
  window.scheduleIconUpdate = paintIcons;

  function setHTML(el, html) {
    if (typeof el === 'string') el = $(el);
    if (!el) return;
    el.innerHTML = html;
    paintIcons();
  }
  // Teks yang ditulis timer: hanya bila berubah (tiap tulis = hitung ulang gaya/tata letak; HP cepat panas).
  function textIf(el, s) { if (el && el.textContent !== s) el.textContent = s; }

  function staggerIndex(root) {
    (root || document).querySelectorAll('.stagger').forEach(function (list) {
      Array.prototype.forEach.call(list.children, function (c, i) { c.style.setProperty('--i', Math.min(i, 12)); });
    });
  }

  function countUp(el, target, opts) {
    if (!el) return;
    opts = opts || {};
    const fmt = opts.format || (v => String(v));
    const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce || !target) { el.textContent = fmt(target || 0); return; }
    const dur = opts.duration || 900, t0 = performance.now();
    (function tick(now) {
      const p = Math.min(1, (now - t0) / dur), e = 1 - Math.pow(1 - p, 3);
      el.textContent = fmt(Math.round(target * e));
      if (p < 1) requestAnimationFrame(tick); else el.textContent = fmt(target);
    })(t0);
  }

  const rupiahShort = v => {
    if (v >= 1e9) return 'Rp' + (v / 1e9).toFixed(1).replace('.', ',') + ' M';
    if (v >= 1e6) return 'Rp' + (v / 1e6).toFixed(1).replace('.', ',') + ' jt';
    return formatRp(v);
  };

  // ── WhatsApp ────────────────────────────────────────────────────────────────
  window.waUrl = function (phone, text) {
    return 'https://wa.me/' + sanitizePhone(phone || '') + '?text=' + encodeURIComponent(text || '');
  };
  window.sendToParentWA = function (phone, text) {
    window.open(window.waUrl(phone, text), '_blank');
  };
  // Nomor WA klien sebuah sesi: dari profil klien (MemberData) yang sekarang; kolom "No WA" di jadwal hanya
  // salinan saat booking dan bisa basi (nomor lama / nomor uji), jadi dipakai hanya bila klien tidak ketemu.
  window.clientPhone = function (s) {
    if (!s) return '';
    const m = s.memberId ? (window.members || []).find(function (x) { return x && String(x.id).trim() === String(s.memberId).trim(); }) : null;
    return String((m && m.phone) || s.phone || '').trim();
  };
  // WA ke klien sesi; nomor kosong = beri tahu, jangan buka wa.me tanpa nomor (pemilih kontak / pesan ke diri sendiri).
  window.waToClient = function (s, text) {
    const p = sanitizePhone(window.clientPhone(s));
    if (p.length < 8) { window.showToast('Nomor WA klien belum diisi.'); return; }
    window.sendToParentWA(p, text);
  };
  // "Coach Vinna" tetap "Coach Vinna"; "Vinna" jadi "Coach Vinna" (tidak pernah "Coach Coach").
  window.coachLabel = function (name) {
    const n = String(name == null ? '' : name).trim();
    return /^coach\b/i.test(n) ? n : 'Coach ' + n;
  };
  // Tampilkan tombol "Buka WhatsApp" setelah aksi berhasil. Pengguna membukanya
  // dengan ketukan sendiri (link biasa), jadi tidak ada tab kosong yang dibuka
  // lebih dulu dan tidak diblokir popup blocker.
  window.showWaPrompt = function (url, message) {
    if (!/^https:\/\/wa\.me\//.test(String(url || ''))) return;
    const old = document.getElementById('wa-prompt');
    if (old) old.remove();
    const box = document.createElement('div');
    box.id = 'wa-prompt';
    box.setAttribute('role', 'status');
    box.style.cssText = 'position:fixed;left:50%;bottom:96px;transform:translateX(-50%);z-index:9999;' +
      'max-width:calc(100vw - 32px);display:flex;align-items:center;gap:12px;flex-wrap:wrap;justify-content:center;' +
      'padding:12px 14px;border-radius:16px;background:#111;color:#fff;box-shadow:0 10px 30px rgba(0,0,0,.28);' +
      'font-size:14px;line-height:1.35;';
    const txt = document.createElement('span');
    txt.textContent = message || 'Lanjutkan lewat WhatsApp.';
    const a = document.createElement('a');
    a.href = url;
    a.target = '_blank';
    a.rel = 'noopener noreferrer';
    a.textContent = 'Buka WhatsApp';
    a.style.cssText = 'background:#25D366;color:#fff;font-weight:700;text-decoration:none;padding:8px 14px;border-radius:10px;white-space:nowrap;';
    const close = document.createElement('button');
    close.type = 'button';
    close.setAttribute('aria-label', 'Tutup');
    close.textContent = '\u00d7';
    close.style.cssText = 'background:transparent;border:0;color:#fff;font-size:22px;line-height:1;cursor:pointer;padding:0 4px;';
    const dismiss = function () { clearTimeout(window._waPromptTimer); box.remove(); };
    close.addEventListener('click', dismiss);
    a.addEventListener('click', function () { setTimeout(dismiss, 300); });
    box.appendChild(txt); box.appendChild(a); box.appendChild(close);
    document.body.appendChild(box);
    clearTimeout(window._waPromptTimer);
    window._waPromptTimer = setTimeout(dismiss, 30000);
  };
  // Nomor WA coach yang dipilih (id); kosong/tidak ketemu → nomor kontak umum (mode solo).
  window.coachPhoneById = function (id) {
    const c = id ? (window.coaches || []).find(function (x) { return x && String(x.id) === String(id) && x.phone; }) : null;
    return c ? sanitizePhone(c.phone) : window.coachContactNumber();
  };
  window.coachContactNumber = function () {
    const fixed = sanitizePhone(COACH_WA_NUMBER || '');
    if (fixed.length >= 10) return fixed;
    const first = (window.coaches || []).find(c => c && c.phone);
    return first ? sanitizePhone(first.phone) : '';
  };

  // ── Server (google.script.run) ─────────────────────────────────────────────
  window.isAuthError = function (err) {
    return !!err && String(err.message || err).indexOf('AUTH_REQUIRED') !== -1;
  };
  window.authMessage = function (err) {
    return String((err && err.message) || err || '').replace(/^.*AUTH_REQUIRED:\s*/, '');
  };

  // Seperti google.script.run, tapi token disisipkan sebagai argumen pertama dan
  // sesi yang habis membuka layar login lagi.
  function tokenRunner(getToken, onAuthLost) {
    let onOk = null, onFail = null, meta = null;
    const proxy = new Proxy({}, {
      get: function (_, prop) {
        if (prop === 'withMeta') return function (m) { meta = m || null; return proxy; };   // {cid, re}: nomor pesanan (antrean simpan)
        if (prop === 'withSuccessHandler') return function (fn) { onOk = fn; return proxy; };
        if (prop === 'withFailureHandler') return function (fn) { onFail = fn; return proxy; };
        return function () {
          const args = [getToken()].concat(Array.prototype.slice.call(arguments));
          const ok = onOk, fail = onFail, m = meta;
          // rpc: google.script.run, fetch ke doPost, atau XNK_TRANSPORT (Scripts.html). then(a, b): galat di ok() tidak memanggil fail().
          rpc(prop, args, m).then(function (res) { if (ok) ok(res); }, function (err) {
            if (window.isAuthError(err) && onAuthLost) onAuthLost(err);
            if (fail) fail(err);
          });
        };
      }
    });
    return proxy;
  }
  window.adminApi = function () { return tokenRunner(function () { return _lsGet(ADMIN_TOKEN_KEY); }, function (err) { window.onAdminAuthLost(err); }); };
  window.memberApi = function () { return tokenRunner(function () { return _lsGet(MEMBER_TOKEN_KEY); }, function (err) { window.onMemberAuthLost(err); }); };

  function rawCall(runner, name, args, meta) {
    return new Promise(function (resolve, reject) {
      if (!hasServer()) { reject(new Error('Mode pratinjau: server tidak tersedia.')); return; }
      const r = (meta && runner.withMeta ? runner.withMeta(meta) : runner).withSuccessHandler(resolve).withFailureHandler(reject);
      r[name].apply(r, args);
    });
  }

  // ── Satu jalur tulis (write lane) ───────────────────────────────────────────
  // Layar optimistic berubah seketika, server menyusul. Tanpa jalur ini aksi cepat beruntun gagal:
  // "Selesai" tepat setelah booking mengirim id sementara (tmp-…) yang belum dikenal server, panggilan
  // bersamaan berebut kunci skrip ("Server sedang sibuk"), dan dua ubahan bisa tiba terbalik.
  // Aturan: setiap fungsi tulis (bukan READ_FN_RE) dan setiap panggilan yang membawa id sementara
  // berjalan SATU PER SATU sesuai urutan ketukan; id sementara diganti id asli saat dikirim; kunci
  // sibuk dicoba lagi sendiri (server menolak sebelum menulis, jadi aman). tests/write-lane.test.js
  // memastikan tidak ada nama di WRITE (tests/api-lists.js) yang cocok dengan READ_FN_RE.
  const READ_FN_RE = /^(get|list|check|export|preview|search|find|count|verify|ping)/;
  const TMP_RE = /^tmp-\d+(-\d+)?$/;
  const LANE_MAX_MS = 45000;          // panggilan macet: jalur dilepas, jawaban tetap ditunggu
  const BUSY_RETRY_MS = [1500, 4000]; // kunci skrip sibuk: dua kali coba lagi
  const wlane = { tail: Promise.resolve(), inflight: 0, gen: 0, alias: {}, dead: {}, idle: {} };
  let tmpN = 0;
  window.tmpId = function () { return 'tmp-' + Date.now() + '-' + (++tmpN); };
  window.isTmpId = function (id) { return TMP_RE.test(String(id == null ? '' : id)); };
  // id sementara → id asli (bila sudah ada); id lain apa adanya.
  function realId(id) {
    let k = String(id == null ? '' : id), n = 0;
    while (wlane.alias[k] && n++ < 5) k = wlane.alias[k];
    return k === String(id) ? id : k;
  }
  window.realId = realId;
  // Jadwal menurut id, juga bila id yang dipegang layar masih id sementara.
  function schedById(id) {
    if (id == null || id === '') return null;
    const a = String(id), b = String(realId(id));
    return (window.schedules || []).find(x => String(x.id) === a || String(x.id) === b) || null;
  }
  window.schedById = schedById;
  function hasTmp(v, d) {
    if (typeof v === 'string') return TMP_RE.test(v);
    if (!v || typeof v !== 'object' || d > 1) return false;
    return Object.keys(v).some(k => hasTmp(v[k], d + 1));
  }
  function resolveVal(v, d) {
    if (typeof v === 'string' && TMP_RE.test(v)) {
      const r = realId(v);
      if (r !== v) return r;
      throw new Error(wlane.dead[v] ? 'Booking ini tidak jadi tersimpan, jadi perubahan dibatalkan.' : 'Jadwal ini masih disimpan. Coba lagi sebentar.');
    }
    if (!v || typeof v !== 'object' || d > 1) return v;
    if (Array.isArray(v)) return v.map(x => resolveVal(x, d + 1));
    if (Object.getPrototypeOf(v) !== Object.prototype) return v;
    const o = {};
    Object.keys(v).forEach(k => { o[k] = resolveVal(v[k], d + 1); });
    return o;
  }
  function resolveArgs(args) { return hasTmp(args, -1) ? args.map(a => resolveVal(a, 0)) : args; }
  window.resolveTmpArgs = function (args) { try { return resolveArgs(args); } catch (e) { return args; } };
  // ── Satu penilai galat (dipakai lane, antrean simpan, workout, makan, booking) ──
  // 'auth' = sesi habis · 'transient' = belum tersambung / Google sedang ramai (simpan nanti, jangan batalkan layar)
  // · 'rejected' = server menolak dengan alasan (tampil di lencana) · 'done' = hapus barang yang sudah tidak ada.
  const TRANSIENT_RE = /network|jaringan|koneksi|failure|failed to fetch|load failed|timed? ?out|HTTP \d|offline|sibuk|Tunggu sebentar|\bquota\b|internal error|too many times|server error occurred|we're sorry|exceeded maximum execution|service unavailable|Versi aplikasi belum cocok|Server sedang diperbarui|masih disimpan|terlalu cepat/i;
  // Pasti belum tersimpan (server menolak sebelum menulis): boleh dicoba lagi langsung di jalur.
  const QUICK_RETRY_RE = /sibuk|too many times|Tunggu sebentar|masih disimpan|terlalu cepat/i;
  function errKind(err, fn) {
    if (window.isAuthError(err)) return 'auth';
    if (err && err.code === 'readonly') return 'rejected';
    if (err && (err.net || err.nonJson !== undefined || err.code === 'inflight' || err.code === 'unknown_fn')) return 'transient';
    const m = String((err && err.message) || err || '');
    if (/^delete/.test(String(fn || '')) && /tidak ditemukan/i.test(m)) return 'done';
    return !m || TRANSIENT_RE.test(m) ? 'transient' : 'rejected';
  }
  window.errKind = errKind;
  // Alur yang sengaja menunggu jawaban (tambah klien, paket baru, unggah…): gangguan sementara diberi kalimat tenang,
  // bukan teks mentah Google. prefix (mis. 'Gagal: ') hanya untuk penolakan sungguhan.
  function waitErr(err, prefix) {
    if (errKind(err) === 'transient') return 'Belum tersambung. Coba lagi sebentar.';
    return (prefix || '') + window.authMessage(err);
  }
  window.waitErr = waitErr;
  function laneIdle() {
    if (wlane.pending()) return;   // antrean simpan masih punya pesanan: tunggu sampai kosong
    const fns = wlane.idle; wlane.idle = {};
    Object.keys(fns).forEach(k => setTimeout(function () { try { fns[k](); } catch (e) { console.error(e); } }, 0));
  }
  wlane.pending = function () { return 0; };   // diganti antrean simpan (jumlah pesanan yang belum terkirim)
  wlane.creating = {};                         // tmp → [resolve…]: pembuatnya masih di antrean
  wlane.laneIdle = laneIdle;
  function lane(job) {
    wlane.inflight++; wlane.gen++;
    const p = wlane.tail.then(job);
    wlane.tail = new Promise(function (res) { p.then(res, res); setTimeout(res, LANE_MAX_MS); });
    const done = function () { wlane.inflight = Math.max(0, wlane.inflight - 1); if (!wlane.inflight) laneIdle(); };
    p.then(done, done);
    return p;
  }
  function sendRetry(runner, name, args, n, meta) {
    let a;
    try { a = resolveArgs(args); } catch (e) { return Promise.reject(e); }
    return rawCall(runner, name, a, meta).catch(function (err) {
      const m = String((err && err.message) || err || '');
      if (n >= BUSY_RETRY_MS.length || err && (err.net || err.nonJson !== undefined) || errKind(err, name) !== 'transient' || !QUICK_RETRY_RE.test(m)) throw err;
      return new Promise(r => setTimeout(r, BUSY_RETRY_MS[n])).then(() => sendRetry(runner, name, args, n + 1, meta));
    });
  }
  // id sementara yang pembuatnya masih menunggu di antrean: tunggu dulu DI LUAR jalur (pembuatnya juga lewat jalur).
  function tmpsOf(v, d, out) {
    if (typeof v === 'string') { if (TMP_RE.test(v)) out.push(v); return out; }
    if (v && typeof v === 'object' && d <= 1) Object.keys(v).forEach(k => tmpsOf(v[k], d + 1, out));
    return out;
  }
  function waitTmp(t) {
    if (wlane.alias[t] || wlane.dead[t] || !wlane.creating[t]) return Promise.resolve();
    return new Promise(function (res) { wlane.creating[t].push(res); setTimeout(res, 90000); });
  }
  function laneSend(runner, name, args, meta) {
    const wait = tmpsOf(args, -1, []).filter(t => !wlane.alias[t] && !wlane.dead[t] && wlane.creating[t]);
    const go = function () { return lane(function () { return sendRetry(runner, name, args, 0, meta); }); };
    return wait.length ? Promise.all(wait.map(waitTmp)).then(go) : go();
  }
  // Terdaftar sebagai tulis (api-lists WRITE) tetapi hanya membaca (mengembalikan pilihan pengganti menu): jangan antre di belakang simpanan.
  const LANE_SKIP = { swapMyMenuMeal: 1, swapMyMenuItem: 1 };
  function call(runner, name) {
    const args = Array.prototype.slice.call(arguments, 2);
    if ((READ_FN_RE.test(name) || LANE_SKIP[name]) && !hasTmp(args, -1)) return rawCall(runner, name, args);
    return laneSend(runner, name, args);
  }
  // Pembuat baris baru dengan id sementara `tmp`: begitu jawaban datang (masih di dalam jalur, jadi
  // aksi berikutnya pada baris itu sudah memakai id asli) id dipetakan, baris di layar diganti namanya.
  function tmpSettled(tmp) { const w = wlane.creating[tmp]; delete wlane.creating[tmp]; (w || []).forEach(f => f()); }
  function bindTmp(tmp, res) {
    const id = res && res.status !== 'conflict' ? (res.id || (res.schedule && res.schedule.id) || '') : '';
    if (!id) { wlane.dead[tmp] = true; tmpSettled(tmp); return; }
    wlane.alias[tmp] = String(id);
    (window.schedules || []).forEach(function (s) { if (String(s.id) === tmp) { s.id = id; delete s.pending; } });
    if (String(window.selectedScheduleDetailId) === tmp) window.selectedScheduleDetailId = id;
    if (String(window.rescheduleScheduleId) === tmp) window.rescheduleScheduleId = id;
    tmpSettled(tmp);
  }
  function tmpDead(tmp) { wlane.dead[tmp] = true; tmpSettled(tmp); }
  function callCreate(runner, tmp, name, args) {
    wlane.creating[tmp] = wlane.creating[tmp] || [];
    return laneSend(runner, name, args).then(function (res) { bindTmp(tmp, res); return res; }, function (err) { tmpDead(tmp); throw err; });
  }
  // Data dari server yang diminta sebelum / selama penulisan bisa basi: jangan timpa layar optimistic.
  window.wqSnap = function () { return wlane.gen; };
  window.wqStale = function (snap) { return wlane.inflight > 0 || wlane.pending() > 0 || wlane.gen !== snap; };
  window.wqBusy = function () { return wlane.inflight > 0 || wlane.pending() > 0; };
  window.wqOnIdle = function (key, fn) { if (!wlane.inflight && !wlane.pending()) setTimeout(fn, 0); else wlane.idle[key] = fn; };

  const adminCall = function (name) { return call.apply(null, [window.adminApi(), name].concat(Array.prototype.slice.call(arguments, 1))); };
  const memberCall = function (name) { return call.apply(null, [window.memberApi(), name].concat(Array.prototype.slice.call(arguments, 1))); };
  const adminCreate = function (tmp, name) { return callCreate(window.adminApi(), tmp, name, Array.prototype.slice.call(arguments, 2)); };
  const memberCreate = function (tmp, name) { return callCreate(window.memberApi(), tmp, name, Array.prototype.slice.call(arguments, 2)); };
  const publicCall = function (name) { return rpc(name, Array.prototype.slice.call(arguments, 1)); };

  // ── Tombol sibuk ────────────────────────────────────────────────────────────
  function busy(btn, label) {
    if (!btn) return function () {};
    const html = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spin" aria-hidden="true"></span> ' + h(label || 'Memproses…');
    return function () { btn.disabled = false; btn.innerHTML = html; paintIcons(); };
  }

  // Klien: panel "memeriksa ketersediaan" (skeleton) di atas form selama server mengecek booking.
  function showChecking(form, text) {
    let el = form.querySelector('.checking-panel');
    if (!el) {
      el = document.createElement('div');
      el.className = 'checking-panel notice';
      el.setAttribute('role', 'status');
      el.style.cssText = 'flex-direction:column;align-items:stretch;gap:10px';
      form.insertBefore(el, form.firstChild);
    }
    el.innerHTML = '<p class="li-title row" style="gap:8px"><span class="spin" aria-hidden="true"></span><span class="chk-text">' + h(text) + '</span></p>' +
      '<div class="skeleton" style="height:14px;width:80%"></div><div class="skeleton" style="height:14px;width:55%"></div>';
    form.setAttribute('aria-busy', 'true');
    form.querySelectorAll('input,select,textarea').forEach(function (i) { i.dataset.wasDisabled = i.disabled ? '1' : ''; i.disabled = true; });
  }
  function setChecking(form, text) { const t = form.querySelector('.chk-text'); if (t) t.textContent = text; }
  function hideChecking(form) {
    const el = form.querySelector('.checking-panel');
    if (el) el.remove();
    form.removeAttribute('aria-busy');
    form.querySelectorAll('input,select,textarea').forEach(function (i) { if (!i.dataset.wasDisabled) i.disabled = false; });
  }

  // ── Toast ───────────────────────────────────────────────────────────────────
  window.showToast = function (msg, iconName) {
    const el = $('toast'), txt = $('toast-msg');
    if (!el || !txt) return;
    txt.textContent = msg;
    const ic = el.querySelector('svg, i');
    if (ic) ic.outerHTML = icon(iconName || (/gagal|error|tidak|habis|salah/i.test(msg) ? 'alert-circle' : 'check-circle-2'));
    paintIcons();
    el.classList.add('show');
    clearTimeout(window._toastTimer);
    window._toastTimer = setTimeout(function () { el.classList.remove('show'); }, 3200);
  };

  // ── Antrean simpan "buku catatan" (xnk_sync, 2026-11-20) ─────────────────────
  // Setiap simpanan dicatat DI PERANGKAT DULU (tab ditutup / tertidur di tengah simpan = tidak hilang), lalu dikirim
  // satu per satu lewat jalur tulis dengan nomor pesanan `id` (cid). Server (Idem.gs) memutar ulang jawaban untuk
  // nomor yang sama, jadi kiriman ulang setelah jawaban hilang tidak menyimpan dua kali.
  //   transient (sinyal, Google ramai) → tetap di antrean, dicoba lagi (5 dtk · 2^n, maks 5 mnt), layar TIDAK dibatalkan
  //   rejected (server menolak dengan alasan) → undo(), pesanan "gagal" tampil di lencana #sync-badge (Coba lagi / Ubah / Buang)
  //   auth → menunggu login akun yang sama (sig)
  // Satu tab saja yang mengirim (sewa xnk_sync_lease); hub xnk.web.id: kunci otomatis berawalan slug.
  // Item: {id, mode, fn, args, sig, label, at, tries, nextAt, state:'pending'|'sending'|'failed', err, tmp?, sentAt?}
  const SQ_KEY = 'xnk_sync', SQ_OLD = 'xnk_outbox', SQ_LEASE = 'xnk_sync_lease';
  const SQ_STUCK_MS = 75000, SQ_MAX_AGE = 7 * 86400000, SQ_BACKOFF = 5000, SQ_BACKOFF_MAX = 300000, SQ_LEASE_MS = 20000;
  const SQ_FRESH_MS = 600000;   // pesanan lebih muda dari ini membuat data server yang baru datang dianggap basi
  const sq = { hooks: {}, flushing: false, timer: null, mem: null, refresh: false,
    tab: Math.random().toString(36).slice(2, 10) + Date.now().toString(36) };
  function sqSig(mode) { const t = _lsGet(mode === 'admin' ? ADMIN_TOKEN_KEY : MEMBER_TOKEN_KEY); return t ? tokenSig(t) : ''; }
  function newCid() { return 'c' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10); }
  function sqRead() {
    if (sq.mem) return sq.mem.map(x => Object.assign({}, x));
    try { const a = JSON.parse(_lsGet(SQ_KEY) || '[]'); return Array.isArray(a) ? a : []; } catch (e) { return []; }
  }
  function sqWrite(a) {
    const s = a.length ? JSON.stringify(a) : null;
    _lsSet(SQ_KEY, s);
    sq.mem = s && _lsGet(SQ_KEY) !== s ? a.map(x => Object.assign({}, x)) : null;   // penyimpanan penuh: antrean di memori
    syncPaint();
  }
  function sqMine(it) { return it.sig && it.sig === sqSig(it.mode); }
  function sqUpdate(id, fn) { const a = sqRead(), it = a.find(x => x.id === id); if (it) { fn(it); sqWrite(a); } return it; }
  window.sqItems = function () { return sqRead().filter(sqMine); };
  function sqPending(fresh) { const now = Date.now(); return sqRead().filter(it => it.state !== 'failed' && sqMine(it) && (!fresh || now - it.at < SQ_FRESH_MS)).length; }
  wlane.pending = function () { return sqPending(true); };
  // Antrean lama (xnk_outbox) dipindah sekali; tries 1 = kirim sebagai ulangan (re).
  setTimeout(function sqMigrate() {   // ditunda: tokenSig (part 03) belum ada saat bagian ini dijalankan
    try {
      const old = JSON.parse(_lsGet(SQ_OLD) || '[]');
      if (Array.isArray(old) && old.length) {
        const a = sqRead();
        old.forEach(it => a.push({ id: newCid(), mode: it.mode, fn: it.fn, args: it.args || [], sig: it.sig || '', label: it.label || '', at: it.at || Date.now(), tries: 1, nextAt: 0, state: 'pending', err: '' }));
        sqWrite(a);
      }
      _lsSet(SQ_OLD, null);
    } catch (e) {}
  }, 0);
  window.obCount = function () { return window.sqItems().length; };
  window.obForget = function (mode) { sqWrite(sqRead().filter(it => it.mode !== mode)); };

  function sqAdd(q, o) {
    o = o || {};
    const it = { id: newCid(), mode: q.mode, fn: q.fn, args: q.args || [], sig: sqSig(q.mode), label: o.label || '', at: Date.now(), tries: 0, nextAt: 0, state: 'pending', err: '' };
    if (o.tmp) { it.tmp = o.tmp; wlane.creating[o.tmp] = wlane.creating[o.tmp] || []; }
    const a = sqRead(); a.push(it); sqWrite(a);
    return new Promise(function (resolve) {
      sq.hooks[it.id] = { then: o.then, undo: o.undo, resolve: resolve, sheet: o.sheet || '', errEl: o.errEl || '' };
      setTimeout(sqFlush, 0);
    });
  }
  function sqLease() {
    const now = Date.now();
    let l = null;
    try { l = JSON.parse(_lsGet(SQ_LEASE) || 'null'); } catch (e) {}
    if (l && l.tab !== sq.tab && l.until > now) return false;
    _lsSet(SQ_LEASE, JSON.stringify({ tab: sq.tab, until: now + SQ_LEASE_MS }));
    return true;
  }
  function sqLater(ms) { clearTimeout(sq.timer); sq.timer = setTimeout(sqFlush, Math.max(500, ms)); }
  function sqRunner(mode) { return mode === 'admin' ? window.adminApi() : window.memberApi(); }
  // Pembuat berhasil: id sementara di pesanan berikutnya diganti id asli (tetap benar setelah halaman dimuat ulang).
  function sqRewriteTmp() {
    const a = sqRead();
    let ch = false;
    a.forEach(it => { if (hasTmp(it.args, -1)) { const r = window.resolveTmpArgs(it.args); if (JSON.stringify(r) !== JSON.stringify(it.args)) { it.args = r; ch = true; } } });
    if (ch) sqWrite(a);
  }
  function sqDone(it, res) {
    sqWrite(sqRead().filter(x => x.id !== it.id));
    if (it.tmp) { bindTmp(it.tmp, res); sqRewriteTmp(); }
    const hk = sq.hooks[it.id];
    delete sq.hooks[it.id];
    if (hk) { if (hk.then) try { hk.then(res); } catch (e) { console.error(e); } hk.resolve(res); }
    else sqNeedsReload(it);   // pesanan dari halaman sebelumnya: muat ulang data saat antrean kosong
  }
  // Simpanan keuangan cukup memuat ulang Keuangan (diam-diam), bukan seluruh panel.
  const SQ_FIN_FN = /^(savePayment|saveExpense|saveBillAdjust|archiveFinanceItem|restoreFinanceItem|saveFinanceCategory|deleteFinanceCategory|saveCoachShare)$/;
  function sqNeedsReload(it) { if (it && SQ_FIN_FN.test(it.fn)) sq.finReload = true; else sq.refresh = true; }
  function sqFail(it, err) {
    const msg = window.authMessage(err) || 'Ditolak server.';
    sqUpdate(it.id, x => { x.state = 'failed'; x.err = msg; delete x.sentAt; });
    if (it.tmp) tmpDead(it.tmp);
    const hk = sq.hooks[it.id];
    if (hk) {
      if (hk.undo) try { hk.undo(); } catch (e) { console.error(e); }
      hk.resolve(undefined);
      hk.then = hk.undo = null;   // lembar & kotak galat tetap dicatat untuk "Ubah"
    }
    window.showToast('Belum tersimpan: ' + (it.label || 'perubahan') + '. Ketuk tanda di atas.', 'cloud-alert');
  }
  function sqFlush() {
    if (sq.flushing) return Promise.resolve();
    const now = Date.now();
    const a = sqRead();
    let ch = false;
    a.forEach(it => {
      if (it.state === 'sending' && now - (it.sentAt || 0) > SQ_STUCK_MS) { it.state = 'pending'; it.tries = Math.max(1, it.tries || 0); ch = true; }   // tab mati / fetch beku: kirim ulang (cid sama)
      if (it.state !== 'failed' && now - it.at > SQ_MAX_AGE) { it.state = 'failed'; it.err = 'Sudah lama tidak terkirim.'; ch = true; }
    });
    if (ch) sqWrite(a);
    const it = a.find(x => x.state !== 'failed' && sqMine(x));
    if (!it) {
      if (sq.refresh) { sq.refresh = sq.finReload = false; if (window.refreshAll) try { window.refreshAll(true); } catch (e) {} }
      else if (sq.finReload) { sq.finReload = false; if (window.finStale) try { window.finStale(); } catch (e) {} }
      wlane.laneIdle();
      return Promise.resolve();
    }
    if (it.state === 'sending') { sqLater(SQ_STUCK_MS); return Promise.resolve(); }   // tab lain sedang mengirim
    if (it.nextAt > now) { sqLater(it.nextAt - now); return Promise.resolve(); }
    if (navigator.onLine === false) return Promise.resolve();                         // 'online' melanjutkan
    if (!sqLease()) { sqLater(SQ_LEASE_MS); return Promise.resolve(); }
    // Pesanan yang bergantung pada id sementara yang tidak akan pernah tersimpan: ikut gagal.
    const lost = tmpsOf(it.args, -1, []).find(t => !wlane.alias[t] && (wlane.dead[t] || !a.some(x => x.tmp === t && x.state !== 'failed' && x.id !== it.id)));
    if (lost) {
      const src = a.find(x => x.tmp === lost);
      sqFail(it, new Error('Menunggu: ' + (src && src.label ? src.label : 'data sebelumnya') + ' yang belum tersimpan.'));
      return sqFlush();
    }
    sq.flushing = true;
    sqUpdate(it.id, x => { x.state = 'sending'; x.sentAt = now; });
    const meta = { cid: it.id, re: (it.tries || 0) > 0 };
    return lane(function () { return sendRetry(sqRunner(it.mode), it.fn, it.args, 0, meta); }).then(function (res) {
      sqDone(it, res); return true;
    }, function (err) {
      const k = errKind(err, it.fn);
      if (k === 'done') { sqDone(it, null); return true; }
      if (k === 'rejected') { sqFail(it, err); return true; }
      // transient / auth: tetap di antrean (layar tidak dibatalkan)
      let wait = 0;
      sqUpdate(it.id, x => {
        x.state = 'pending'; delete x.sentAt;
        x.tries = (x.tries || 0) + 1;
        wait = k === 'auth' ? 0 : Math.min(SQ_BACKOFF * Math.pow(2, x.tries - 1), SQ_BACKOFF_MAX);
        x.nextAt = Date.now() + wait; x.err = k === 'auth' ? '' : window.authMessage(err);
      });
      if (k === 'transient') sqLater(wait);
      return false;   // auth: layar login; lanjut setelah masuk lagi (sig sama)
    }).then(function (more) {
      sq.flushing = false;
      if (more) return sqFlush();
    });
  }
  window.obFlush = window.sqFlush = sqFlush;
  function sqWake() { const a = sqRead(); let ch = false; a.forEach(it => { if (it.state === 'pending' && it.nextAt > Date.now()) { it.nextAt = 0; ch = true; } }); if (ch) sqWrite(a); sqFlush(); }
  window.addEventListener('online', function () { sqWake(); syncPaint(); });
  window.addEventListener('offline', function () { syncPaint(); });
  document.addEventListener('visibilitychange', function () { if (!document.hidden) sqFlush(); });
  window.addEventListener('pageshow', function () { sqFlush(); });
  window.addEventListener('focus', function () { sqFlush(); });
  setInterval(function () { if (!document.hidden && sqPending()) sqFlush(); }, 15000);   // timer latar dibekukan browser: cek lagi saat terlihat
  // Tab ditutup sebelum pesanan pertama sempat dikirim: kirim sekali dengan keepalive (jawaban tidak dibaca; pembukaan
  // berikutnya mengirim ulang dengan cid yang sama dan server memutar ulang jawabannya).
  window.addEventListener('pagehide', function () {
    // Lepas giliran kirim milik tab ini: halaman yang dibuka lagi tidak perlu menunggu lease 20 detik habis (2026-11:
    // "Lunasi" pertama setelah aplikasi dibuka ulang tertahan sampai 20 detik).
    try { const l = JSON.parse(_lsGet(SQ_LEASE) || 'null'); if (l && l.tab === sq.tab) _lsSet(SQ_LEASE, null); } catch (e) {}
    try {
      if (typeof window.XNK_TRANSPORT === 'function' || !window.XNK_CONFIG || !window.XNK_CONFIG.exec || typeof fetch !== 'function') return;
      const it = sqRead().find(x => x.state === 'pending' && !x.tries && sqMine(x));
      if (!it || hasTmp(it.args, -1)) return;
      const tok = _lsGet(it.mode === 'admin' ? ADMIN_TOKEN_KEY : MEMBER_TOKEN_KEY);
      const body = JSON.stringify({ fn: it.fn, args: [tok].concat(it.args), cid: it.id, re: 0 });
      if (body.length > 60000) return;
      sqUpdate(it.id, x => { x.tries = 1; });
      fetch(window.XNK_CONFIG.exec, { method: 'POST', headers: { 'Content-Type': 'text/plain' }, body: body, keepalive: true, credentials: 'omit' }).catch(function () {});
    } catch (e) {}
  });

  // ── Lencana sinkron (#sync-badge di bilah atas) ─────────────────────────────
  // Belum tersimpan (N) › tanpa sinyal › Menyimpan… (setelah 3 dtk) › Data 10:42 (salinan lama) › tersembunyi.
  ui.staleAt = 0;
  window.setStaleAt = function (t) { ui.staleAt = t || 0; syncPaint(); };
  let syncTick = null;
  function syncPaint() {
    const el = document.getElementById('sync-badge');
    if (!el) return;
    const items = window.sqItems ? window.sqItems() : [];
    const extra = syncExtraItems().length;
    const failed = items.filter(x => x.state === 'failed').length + extra;
    const pend = items.filter(x => x.state !== 'failed');
    const now = Date.now(), oldest = pend.reduce((m, x) => Math.min(m, x.at), now);
    let html = '', cls = '', label = '';
    if (failed) { cls = 'bad'; label = failed + ' perubahan belum tersimpan'; html = icon('cloud-alert') + '<span class="lbl">Belum tersimpan</span><span class="num">' + failed + '</span>'; }
    else if (pend.length && navigator.onLine === false) { label = 'Tanpa sinyal, ' + pend.length + ' menunggu dikirim'; html = icon('cloud-off') + '<span class="num">' + pend.length + '</span>'; }
    else if (pend.length && now - oldest > 3000) { label = 'Menyimpan ' + pend.length + ' perubahan'; html = '<span class="spin" aria-hidden="true"></span><span class="lbl">Menyimpan…</span>'; }
    else if (ui.staleAt) { const d = new Date(ui.staleAt); label = 'Data dari ' + fmtTime(d) + '. Ketuk untuk memuat ulang'; html = icon('clock') + '<span class="lbl">Data ' + fmtTime(d) + '</span>'; }
    el.classList.toggle('hide', !html);
    el.classList.toggle('bad', cls === 'bad');
    el.setAttribute('aria-label', label || 'Semua tersimpan');
    if (el._last !== html) { el.innerHTML = html; el._last = html; paintIcons(); }
    // Panel coach di layar lebar: bilah atas setinggi 0, tombol halaman melayang di kanan atas; lencana di sebelah kirinya.
    const acts = html && window.innerWidth >= 768 && !document.documentElement.classList.contains('desk') ? document.getElementById('topbar-actions') : null;
    if (acts) el.style.setProperty('--sync-r', 'calc(max(var(--page-pad), var(--sa-r)) + ' + (acts.offsetWidth ? acts.offsetWidth + 8 : 0) + 'px)');
    clearTimeout(syncTick);
    if (pend.length) syncTick = setTimeout(syncPaint, 1000);
    if (ui.sheetOn && window.currentSheetId === 'sheet-sync') syncList();
  }
  window.syncPaint = syncPaint;
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', syncPaint); else setTimeout(syncPaint, 0);
  window.openSyncSheet = function () {
    const items = window.sqItems();
    if (!items.length && !syncExtraItems().length && ui.staleAt) { if (window.refreshAll) window.refreshAll(true); return; }
    syncList();
    openSheet('sheet-sync');
    window.currentSheetId = 'sheet-sync';
  };
  function syncList() {
    const box = document.getElementById('sync-list');
    if (!box) return;
    const items = window.sqItems();
    const row = function (it) {
      const t = new Date(it.at), hk = sq.hooks[it.id];
      const when = fmtShort(t) + ' ' + fmtTime(t);
      const btn = (fn, ic, txt, c) => '<button type="button" class="btn ' + (c || 'btn-outline') + ' btn-sm" onclick="window.' + fn + '(\'' + h(it.id) + '\')">' + icon(ic) + h(txt) + '</button>';
      const acts = it.state === 'failed'
        ? btn('syncRetry', 'rotate-cw', 'Coba lagi', 'btn-secondary') + (hk && hk.sheet ? btn('syncEdit', 'pencil', 'Ubah') : '') + btn('syncDrop', 'trash-2', 'Buang', 'btn-ghost')
        : (Date.now() - it.at > 3600000 ? btn('syncDrop', 'trash-2', 'Buang', 'btn-ghost') : '');
      return '<div class="card-flat stack" style="gap:8px"><div class="row-between"><p class="li-title">' + h(it.label || it.fn) + '</p><span class="li-sub num">' + h(when) + '</span></div>' +
        (it.state === 'failed' ? '<p class="li-sub" style="color:var(--danger)">' + h(it.err || 'Ditolak server.') + '</p>' : '<p class="li-sub">' + (navigator.onLine === false ? 'Menunggu sinyal' : it.state === 'sending' ? 'Sedang dikirim…' : 'Menunggu dikirim') + '</p>') +
        (acts ? '<div class="btn-row">' + acts + '</div>' : '') + '</div>';
    };
    const failed = items.filter(x => x.state === 'failed'), pend = items.filter(x => x.state !== 'failed');
    // Antrean latihan (xnk_wl_queue) dan makan (xnk_food_failed) punya penyimpanan sendiri; di sini hanya ditampilkan.
    const extraRow = function (it) {
      const t = new Date(it.at), b = (fn, ic, txt, c) => '<button type="button" class="btn ' + (c || 'btn-outline') + ' btn-sm" onclick="window.' + fn + '(\'' + h(it.id) + '\')">' + icon(ic) + h(txt) + '</button>';
      const acts = it.kind === 'wl'
        ? b('syncWlRetry', 'rotate-cw', 'Coba lagi', 'btn-secondary') + b('syncWlEdit', 'pencil', 'Ubah') + b('syncWlDrop', 'trash-2', 'Buang', 'btn-ghost')
        : b('syncFqOpen', 'utensils', 'Buka Makan') + b('syncFqDrop', 'x', 'Tutup', 'btn-ghost');
      return '<div class="card-flat stack" style="gap:8px"><div class="row-between"><p class="li-title">' + h(it.label) + '</p><span class="li-sub num">' + h(fmtShort(t) + ' ' + fmtTime(t)) + '</span></div>' +
        '<p class="li-sub" style="color:var(--danger)">' + h(it.err || 'Ditolak server.') + '</p><div class="btn-row">' + acts + '</div></div>';
    };
    const extra = syncExtraItems();
    let html = '';
    if (failed.length) html += '<p class="group-label">Belum tersimpan</p>' + failed.map(row).join('');
    if (extra.length) html += '<p class="group-label">Latihan &amp; makan belum tersimpan</p>' + extra.map(extraRow).join('');
    if (pend.length) html += '<p class="group-label">Menunggu dikirim</p>' + pend.map(row).join('');
    if (!html) html = '<p class="li-sub" style="min-height:44px;display:flex;align-items:center">Semua perubahan sudah tersimpan.</p>';
    setHTML(box, html);
  }
  function syncExtraItems() {
    try { return [].concat(window.wlFailedItems ? window.wlFailedItems() : [], window.fqFailedItems ? window.fqFailedItems() : []); } catch (e) { return []; }
  }
  const syncAfter = function () { syncPaint(); if (!window.sqItems().length && !syncExtraItems().length) window.closeModal(); };
  window.syncWlRetry = function (id) { if (window.wlRetryOne) window.wlRetryOne(id); setTimeout(syncAfter, 300); };
  window.syncWlEdit = function (id) { window.closeModal(); setTimeout(function () { if (window.wlReopen) window.wlReopen(id); syncPaint(); }, 300); };
  window.syncWlDrop = function (id) { if (window.wlDrop) window.wlDrop(id); syncAfter(); };
  window.syncFqOpen = function (id) { if (window.fqFailedDrop) window.fqFailedDrop(id); window.closeModal(); setTimeout(function () { window.navigate('public-food'); }, 300); };
  window.syncFqDrop = function (id) { if (window.fqFailedDrop) window.fqFailedDrop(id); syncAfter(); };
  window.syncRetry = function (id) { sqNeedsReload(sqRead().find(x => x.id === id)); sqUpdate(id, x => { x.state = 'pending'; x.err = ''; x.nextAt = 0; x.tries = Math.max(1, x.tries || 0); x.at = Date.now(); }); syncPaint(); sqFlush(); };
  window.syncDrop = function (id) {
    const hk = sq.hooks[id], dropped = sqRead().find(x => x.id === id);
    sqWrite(sqRead().filter(x => x.id !== id));
    delete sq.hooks[id];
    if (hk && hk.undo) try { hk.undo(); } catch (e) {}
    if (hk && hk.resolve) hk.resolve(undefined);
    syncPaint();
    if (!window.sqItems().length) {
      window.closeModal();
      if (dropped && SQ_FIN_FN.test(dropped.fn) && window.finStale) window.finStale(); else if (window.refreshAll) window.refreshAll(true);
    }
  };
  window.syncEdit = function (id) {
    const it = sqRead().find(x => x.id === id), hk = sq.hooks[id];
    if (!it || !hk || !hk.sheet) return;
    sqWrite(sqRead().filter(x => x.id !== id));
    delete sq.hooks[id];
    window.closeModal();
    setTimeout(function () {
      openSheet(hk.sheet);
      const box = hk.errEl && document.getElementById(hk.errEl);
      if (box) box.textContent = it.err || '';
    }, 300);
  };

  // ── Simpan langsung berhasil (optimistic UI) ────────────────────────────────
  // optimistic({ q:{mode:'admin'|'member', fn, args} | call:()=>Promise, sheet, errEl, ok, label, then(res), undo(), tmp })
  //   Layar langsung berubah (lembar `sheet` ditutup, toast `ok`), server bekerja di belakang.
  //   `q` (bawaan untuk simpanan baru): masuk antrean simpan di atas (nomor pesanan, coba lagi sendiri, lencana).
  //   `tmp`: pesanan ini membuat baris dengan id sementara itu (bindTmp saat berhasil).
  //   `call` (hanya alur yang sengaja menunggu jawaban): ditolak = undo() + lembar dibuka lagi + pop-up.
  const fp = { n: 0, last: '' };
  function failPopup(label, err, retry) {
    const msg = window.authMessage(err) || 'Terjadi kesalahan.';
    fp.n++; fp.last = msg;
    const more = fp.n > 1 ? '<p class="li-sub" style="margin-top:8px">' + fp.n + ' perubahan belum tersimpan.</p>' : '';
    window.showConfirmModal('<b>' + h(label || 'Perubahan') + '</b> belum tersimpan.<br>' + h(msg) + more, function () {
      fp.n = 0; if (retry) retry();
    }, { title: 'Gagal menyimpan', confirmText: retry ? 'Coba lagi' : 'Oke', cancelText: 'Tutup', variant: 'danger', icon: 'circle-alert' });
    const no = $('btn-confirm-modal-no');
    if (no) no.onclick = function () { fp.n = 0; window.closeConfirmModal(); };
  }
  window.failPopup = failPopup;

  function optimistic(o) {
    if (o.sheet === true) {   // lembar yang sedang terbuka; dibuka lagi bila ditolak
      const cur = ui.sheetOn && document.querySelector('#sheet-layer > .sheet:not(.hide)');
      o = Object.assign({}, o, { sheet: cur ? cur.id : '' });
    }
    if (o.sheet) window.closeModal();
    if (o.ok !== false) window.showToast(o.ok || 'Tersimpan.');
    if (o.q) return sqAdd(o.q, o);
    return o.call().then(function (res) {
      if (o.then) try { o.then(res); } catch (e) { console.error(e); }
      return res;
    }, function (err) {
      if (o.undo) try { o.undo(); } catch (e) { console.error(e); }
      if (window.isAuthError(err)) return;
      if (o.sheet) openSheet(o.sheet);
      // Lembar punya kotak galat sendiri: pesan server tampil di sana (tanpa pop-up kedua).
      const box = o.errEl && o.sheet && document.getElementById(o.errEl);
      if (box) { box.textContent = window.authMessage(err); return; }
      failPopup(o.label, err, function () { optimistic(o); });
    });
  }
  window.optimistic = optimistic;

  // ── Tema ────────────────────────────────────────────────────────────────────
  function currentTheme() {
    try { return localStorage.getItem('xnk_theme') || 'system'; } catch (e) { return 'system'; }
  }
  window.setTheme = function (mode) {
    try { if (mode === 'system') localStorage.removeItem('xnk_theme'); else localStorage.setItem('xnk_theme', mode); } catch (e) {}
    if (mode === 'system') document.documentElement.removeAttribute('data-theme');
    else document.documentElement.setAttribute('data-theme', mode);
    renderThemeSeg();
    setTimeout(function () { if (window.hostPostTheme) window.hostPostTheme(); }, 50);
  };
  function renderThemeSeg() {
    ['theme-seg', 'theme-seg-2', 'theme-seg-3'].forEach(renderOneThemeSeg);
  }
  function renderOneThemeSeg(segId) {
    const seg = $(segId);
    if (!seg) return;
    const mode = currentTheme();
    const opts = [['system', 'monitor', 'Otomatis'], ['light', 'sun', 'Terang'], ['dark', 'moon', 'Gelap']];
    seg.innerHTML = '<span class="seg-thumb"></span>' + opts.map(function (o) {
      return '<button type="button" role="radio" aria-checked="' + (o[0] === mode) + '" class="' + (o[0] === mode ? 'active' : '') + '" onclick="window.setTheme(\'' + o[0] + '\')">' + icon(o[1], 'style="width:15px;height:15px;vertical-align:-3px"') + ' ' + o[2] + '</button>';
    }).join('');
    paintIcons();
    moveSegThumb(seg);
  }
  function moveSegThumb(seg) {
    if (!seg) return;
    requestAnimationFrame(function () {
      const active = seg.querySelector('button.active'), thumb = seg.querySelector('.seg-thumb');
      if (!active || !thumb) return;
      thumb.style.width = active.offsetWidth + 'px';
      thumb.style.transform = 'translateX(' + (active.offsetLeft - 4) + 'px)';
    });
  }

  // ── iPhone / Safari: jembatan ke halaman pembungkus (Fase N) ────────────────
  // Aplikasi berjalan di iframe (xnk.my.id, book.xnkbooking.my.id). Di iframe iOS
  // memberi env(safe-area-inset-*) = 0 dan visualViewport tidak melihat keyboard,
  // jadi halaman pembungkus mengukurnya dan mengirim angka saja. Tidak ada data,
  // token, atau nomor yang lewat jalur ini.
  const HOST_ORIGINS = ['https://xnk.my.id', 'https://book.xnkbooking.my.id', 'https://xnkbooking.my.id'];
  const host = { ios: false, standalone: false, kb: 0, origin: '' };
  function hostNum(v) { v = Math.round(Number(v)); return isFinite(v) ? Math.max(0, Math.min(v, 600)) : 0; }
  window.applyHostInfo = function (d) {
    if (!d) return;
    const root = document.documentElement, ins = d.insets || {};
    ['t', 'r', 'b', 'l'].forEach(function (k) { root.style.setProperty('--sa-' + k, Math.min(hostNum(ins[k]), 200) + 'px'); });
    const kb = hostNum(d.kb);
    root.style.setProperty('--kb', kb + 'px');
    host.ios = !!d.ios; host.standalone = !!d.standalone;
    root.classList.toggle('ios', host.ios);
    root.classList.toggle('standalone', host.standalone);
    const open = kb > 80;
    if (open !== root.classList.contains('kb-open')) {
      root.classList.toggle('kb-open', open);
      if (open) hostRevealFocus();
    }
    host.kb = kb;
    a2hsMaybe();   // pesan host datang setelah layar pertama
  };
  // Keyboard terbuka: geser kolom yang sedang diketik ke tengah ruang yang tersisa.
  function hostRevealFocus() {
    const el = document.activeElement;
    if (!el || !/^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName)) return;
    setTimeout(function () { try { el.scrollIntoView({ block: 'center', behavior: 'smooth' }); } catch (e) {} }, 60);
  }
  // Halaman statis di level atas: host-local.js menjawab pesan yang sama dari window itu sendiri (Phase AAA).
  const hostLocal = () => window.top === window && window.XNKHostLocal === true;
  function hostPostTheme() {
    if (window.top === window && !hostLocal()) return;
    // Di HP bagian atas layar adalah band hitam, jadi bilah status mengikuti --band; selain itu --bg.
    // Token (bukan warna body yang sedang bertransisi).
    const cs = getComputedStyle(document.documentElement);
    const phone = window.matchMedia('(max-width: 767px)').matches;
    let color = (phone ? cs.getPropertyValue('--band') : '').trim().toLowerCase();
    if (!/^#[0-9a-f]{6}$/.test(color)) color = cs.getPropertyValue('--bg').trim().toLowerCase();
    if (!/^#[0-9a-f]{6}$/.test(color)) return;
    try { window.top.postMessage({ xnk: 'theme', color: color }, '*'); } catch (e) {}
  }
  window.hostPostTheme = hostPostTheme;
  // Teks besar (Fase R): font scaling tidak memicu media query, jadi periksa ukuran dasar.
  (function bigText() {
    function check() { try { document.documentElement.classList.toggle('big-text', parseFloat(getComputedStyle(document.documentElement).fontSize) >= 20); } catch (e) {} }
    check(); window.addEventListener('resize', check);
  })();
  // App Android / iOS XNK: back sistem (tombol / geser samping) menggantikan panah kembali di layar.
  document.documentElement.classList.toggle('app-shell', /XNKAndroid|XNKiOS/.test(navigator.userAgent));
  (function hostBridge() {
    if (window.top === window && !hostLocal()) return;
    window.addEventListener('message', function (e) {
      if (e.source !== window.top || (HOST_ORIGINS.indexOf(e.origin) === -1 && !(hostLocal() && e.origin === location.origin))) return;
      const d = e.data;
      if (d && d.xnk === 'host' && d.v === 1) {
        const first = !host.origin;
        host.origin = e.origin;
        window.applyHostInfo(d);
        if (first) setTimeout(offlineSync, 0);   // pembungkus dikenal: kirim salinan & ambil catatan offline
      } else if (d && d.xnk === 'offline-queue' && Array.isArray(d.items)) offlineImport(d.items);
    });
    try { window.top.postMessage({ xnk: 'host?' }, '*'); } catch (e) {}
    // Fokus ke kolom saat keyboard sudah terbuka (pindah kolom) juga perlu digeser.
    document.addEventListener('focusin', function () { if (host.kb > 80) hostRevealFocus(); });
    // Tema otomatis ikut sistem: warna bar Safari ikut berubah.
    try { window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () { setTimeout(hostPostTheme, 50); }); } catch (e) {}
    setTimeout(hostPostTheme, 0);
  })();

  // Mode Layar Utama di iPhone tidak punya gestur geser-kembali: geser dari tepi kiri = back.
  (function edgeSwipeBack() {
    let x0 = null, y0 = 0;
    document.addEventListener('touchstart', function (e) {
      x0 = null;
      if (!host.standalone || !host.ios || e.touches.length !== 1 || !isPhone() || bk.n === 0) return;
      const t = e.touches[0];
      if (t.clientX > 20 || (e.target.closest && e.target.closest('.sheet-handle, .drag-grip, input, textarea'))) return;
      x0 = t.clientX; y0 = t.clientY;
    }, { passive: true });
    document.addEventListener('touchend', function (e) {
      if (x0 === null) return;
      const t = e.changedTouches[0], dx = t.clientX - x0, dy = Math.abs(t.clientY - y0);
      x0 = null;
      if (dx > 70 && dy < 40 && !ui.pulling) history.back();
    }, { passive: true });
    document.addEventListener('touchcancel', function () { x0 = null; }, { passive: true });
  })();

  // Ajakan pasang ke Layar Utama: iPhone di Safari biasa, sudah masuk, sekali saja
  // ("Nanti" = tanya lagi 7 hari kemudian). Hanya di perangkat ini (localStorage).
  const A2HS_KEY = 'xnk_a2hs';
  let a2hsTimer = 0;
  function a2hsMaybe() {
    if (!host.ios || host.standalone || !isPhone() || ui.a2hsShown) return;
    const loggedIn = window.isPublicView ? !!window.publicLoggedMember : !!_lsGet(ADMIN_TOKEN_KEY);
    if (!loggedIn) return;
    const v = _lsGet(A2HS_KEY);
    if (v === 'ok' || (v && Date.now() < Number(v))) return;
    clearTimeout(a2hsTimer);
    a2hsTimer = setTimeout(function () {
      if (ui.a2hsShown || ui.guideOn || ui.sheetOn || ui.wlOn) return;
      ui.a2hsShown = true;
      const el = $('a2hs');
      if (el) { el.classList.remove('hide'); paintIcons(); }
    }, 2500);
  }
  window.a2hsClose = function (forever) {
    _lsSet(A2HS_KEY, forever ? 'ok' : String(Date.now() + 7 * 864e5));
    const el = $('a2hs');
    if (el) el.classList.add('hide');
  };

  // ── Lapisan sheet / modal ───────────────────────────────────────────────────
  function openSheet(id) {
    const layer = $('sheet-layer'), sheet = $(id);
    if (!layer || !sheet) return;
    clearTimeout(ui.closeTimer);
    if (layer.classList.contains('hide')) ui.lastFocus = document.activeElement;
    layer.querySelectorAll(':scope > .sheet').forEach(function (s) { s.classList.add('hide'); s.style.transform = ''; });
    sheet.classList.remove('hide');
    layer.classList.remove('hide');
    requestAnimationFrame(function () { requestAnimationFrame(function () { layer.classList.add('open'); }); });
    paintIcons();
    setTimeout(function () {
      const f = sheet.querySelector('input:not([type=hidden]):not(.sr-only), select, textarea, button.btn-primary');
      if (f && window.innerWidth >= 768) try { f.focus({ preventScroll: true }); } catch (e) {}
    }, 260);
    ui.sheetOn = true;
    syncBack();
  }
  window.openSheet = openSheet;

  window.closeModal = function () {
    const layer = $('sheet-layer');
    if (!layer || layer.classList.contains('hide')) return;
    // Lembar cari gerakan dari editor program: tutup/back kembali ke lembar program (isi form tetap).
    if (ui.sheetReturn && ui.sheetOn && ['ex-search', 'sheet-ukur'].some(function (k) { const x = $(k); return x && !x.classList.contains('hide'); })) { const r = ui.sheetReturn; ui.sheetReturn = ''; openSheet(r); return; }
    ui.sheetReturn = '';
    layer.classList.remove('open');
    ui.sheetOn = false;
    window.isRescheduleMode = false;
    window.rescheduleScheduleId = null;
    document.querySelectorAll('.pkg-panel').forEach(function (p) { p.classList.add('hide'); });
    clearTimeout(ui.closeTimer);
    ui.closeTimer = setTimeout(function () {
      layer.classList.add('hide');
      layer.querySelectorAll(':scope > .sheet').forEach(function (s) { s.classList.add('hide'); s.style.transform = ''; });
      if (ui.lastFocus && ui.lastFocus.focus) try { ui.lastFocus.focus({ preventScroll: true }); } catch (e) {}
    }, 440);
    syncBack();
  };

  // Tarik sheet ke bawah untuk menutup (HP).
  (function enableSheetDrag() {
    document.addEventListener('pointerdown', function (e) {
      const handle = e.target.closest && e.target.closest('.sheet-handle');
      if (!handle || window.innerWidth >= 768) return;
      const sheet = handle.closest('.sheet');
      const layer = sheet && sheet.closest('.layer');
      if (!sheet || !layer) return;
      const y0 = e.clientY;
      let dy = 0;
      sheet.classList.add('dragging');
      function move(ev) { dy = Math.max(0, ev.clientY - y0); sheet.style.transform = 'translateY(' + dy + 'px)'; }
      function up() {
        document.removeEventListener('pointermove', move);
        document.removeEventListener('pointerup', up);
        sheet.classList.remove('dragging');
        if (dy > 110) {
          if (layer.id === 'modal-confirm') window.closeConfirmModal(); else window.closeModal();
        } else {
          sheet.style.transform = '';
        }
      }
      document.addEventListener('pointermove', move);
      document.addEventListener('pointerup', up);
    });
  })();

  // Konfirmasi
  window.showConfirmModal = function (message, onConfirm, opts) {
    opts = opts || {};
    window.confirmCallback = onConfirm;
    $('confirm-modal-title').textContent = opts.title || 'Yakin?';
    $('confirm-modal-message').innerHTML = message;
    const yes = $('btn-confirm-modal-yes'), no = $('btn-confirm-modal-no');
    yes.textContent = opts.confirmText || 'Ya, lanjutkan';
    no.textContent = opts.cancelText || 'Batal';
    const danger = opts.variant === 'danger';
    yes.className = 'btn ' + (danger ? 'btn-danger' : 'btn-primary');
    const wrap = $('confirm-modal-icon-wrap');
    wrap.className = 'confirm-icon' + (danger ? ' danger' : '');
    wrap.innerHTML = icon(opts.icon || (danger ? 'triangle-alert' : 'circle-help'));
    const layer = $('modal-confirm');
    clearTimeout(ui.confirmTimer);
    layer.querySelector('.sheet').style.transform = '';
    layer.classList.remove('hide');
    requestAnimationFrame(function () { requestAnimationFrame(function () { layer.classList.add('open'); }); });
    paintIcons();
    setTimeout(function () { try { yes.focus({ preventScroll: true }); } catch (e) {} }, 200);
  };
  window.closeConfirmModal = function () {
    const layer = $('modal-confirm');
    layer.classList.remove('open');
    clearTimeout(ui.confirmTimer);
    ui.confirmTimer = setTimeout(function () { layer.classList.add('hide'); layer.querySelector('.sheet').style.transform = ''; }, 440);
  };
  window.handleConfirmModalYes = function () {
    const cb = window.confirmCallback;
    window.confirmCallback = null;
    window.closeConfirmModal();
    if (typeof cb === 'function') cb();
  };

  // ── Panel detail ────────────────────────────────────────────────────────────
  function openDetail(key, title, actionsHtml, bodyHtml) {
    const panel = $('detail-panel');
    const prevKey = ui.detail;
    panel.classList.toggle('static', !!ui.refreshing && ui.detail === key);
    ui.detail = key;
    panel.setAttribute('data-kind', String(key).split(':')[0]);
    // PC (>= 1200 px, lewat CSS): di halaman Klien panel jadi lebar dan daftar jadi ringkas. View lain tetap 420 px.
    clearTimeout(ui.wideTimer);
    $('app').classList.toggle('detail-wide', window.currentView === 'clients');
    $('detail-title').textContent = title || '';
    setHTML('detail-actions', actionsHtml || '');
    setHTML('detail-body', bodyHtml);
    staggerIndex(panel);
    const wasOpen = panel.classList.contains('open');
    panel.classList.add('open');
    panel.setAttribute('aria-hidden', 'false');
    $('detail-backdrop').classList.add('open');
    $('app').classList.add('detail-open');
    if (!wasOpen) ui.detailFocus = document.activeElement;
    if (!wasOpen || prevKey !== key) $('detail-body').scrollTop = 0;   // pindah klien mulai dari atas
    highlightSelection();
    if (!ui.refreshing && window.currentView === 'clients' && /^client:/.test(key)) revealSelected(wasOpen ? 0 : 460);
    syncBack();
  }
  window.closeDetail = function () {
    const panel = $('detail-panel');
    if (!panel.classList.contains('open')) return;
    panel.classList.remove('open');
    panel.setAttribute('aria-hidden', 'true');
    $('detail-backdrop').classList.remove('open');
    $('app').classList.remove('detail-open');
    // Lepas mode lebar sesudah transisi menutup (--t-slow), supaya isi panel tidak menyempit di tengah animasi.
    clearTimeout(ui.wideTimer); clearTimeout(ui.revealTimer);
    ui.wideTimer = setTimeout(function () { if (!panel.classList.contains('open')) $('app').classList.remove('detail-wide'); }, 460);
    const closedKey = ui.detail;
    ui.detail = null;
    ui.cpTab = null;
    window.selectedScheduleDetailId = null;
    highlightSelection();
    let back = ui.detailFocus;
    // Daftar klien bisa sudah dirender ulang: kembalikan fokus ke kartu yang sama.
    if (back && !back.isConnected && closedKey) back = document.querySelector('#client-list [data-key="' + String(closedKey).replace(/["\\]/g, '') + '"]');
    if (back && back.focus) try { back.focus({ preventScroll: true }); } catch (e) {}
    syncBack();
  };
  function refreshDetail() {
    if (!ui.detail) return;
    ui.refreshing = true;
    try { refreshDetailInner(); } finally { ui.refreshing = false; }
  }
  function refreshDetailInner() {
    const parts = ui.detail.split(':'), kind = parts[0], id = parts.slice(1).join(':');
    if (kind === 'client') {
      if (window.members.some(m => String(m.id) === id)) window.openProfile(id); else window.closeDetail();
    } else if (kind === 'coach') {
      if (window.coaches.some(c => String(c.id) === id)) window.openCoachProfile(id); else window.closeDetail();
    } else if (kind === 'session') {
      if (schedById(id)) window.openScheduleDetail(id); else window.closeDetail();
    } else if (kind === 'bill') {
      if (window.finRefreshBill) window.finRefreshBill(id);   // tagihan di luar data halaman: biarkan seperti adanya
    }
  }
  function highlightSelection() {
    const key = ui.detail || '';
    document.querySelectorAll('[data-key]').forEach(function (el) {
      el.classList.toggle('selected', el.getAttribute('data-key') === key);
    });
  }
  // PC: setelah daftar berubah jadi ringkas (panel lebar), pastikan klien yang dibuka tetap terlihat di daftar.
  function revealSelected(delay) {
    clearTimeout(ui.revealTimer);
    ui.revealTimer = setTimeout(function () {
      if (isPhone()) return;
      const row = document.querySelector('#client-list .selected'), sc = $('main-scroll-area');
      if (!row || !sc) return;
      const r = row.getBoundingClientRect(), b = sc.getBoundingClientRect();
      if (r.top < b.top + 8 || r.bottom > b.bottom - 8) sc.scrollTo({ top: Math.max(0, sc.scrollTop + r.top - b.top - (b.height - r.height) / 2) });
    }, delay);
  }

  // Tooltip grafik
  (function tooltips() {
    let tip = null;
    document.addEventListener('pointerover', function (e) {
      const t = e.target.closest && e.target.closest('[data-tip]');
      tip = tip || $('chart-tooltip');
      if (!tip) return;
      if (!t) { tip.classList.remove('show'); return; }
      const r = t.getBoundingClientRect();
      tip.textContent = t.getAttribute('data-tip');
      tip.style.left = (r.left + r.width / 2) + 'px';
      tip.style.top = r.top + 'px';
      tip.classList.add('show');
    });
    document.addEventListener('scroll', function () { if (tip) tip.classList.remove('show'); }, true);
  })();

  // Keyboard: Esc menutup lapisan paling atas, "/" mencari klien.
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      if (!$('modal-confirm').classList.contains('hide')) { window.closeConfirmModal(); return; }
      if (!$('sheet-layer').classList.contains('hide')) { window.closeModal(); return; }
      if (ui.wlOn) { window.wlClose(); return; }
      if ($('detail-panel').classList.contains('open')) { window.closeDetail(); return; }
    }
    const typing = /INPUT|TEXTAREA|SELECT/.test((document.activeElement || {}).tagName || '');
    if (e.key === '/' && !typing && window.currentView === 'clients') {
      const s = $('search-client');
      if (s) { e.preventDefault(); s.focus(); }
    }
    // PC: panah atas/bawah di daftar Klien membuka klien sebelum/sesudahnya (hanya saat fokus di daftar).
    if ((e.key === 'ArrowDown' || e.key === 'ArrowUp') && !e.repeat && !typing && !e.altKey && !e.ctrlKey && !e.metaKey && !e.shiftKey &&
        window.currentView === 'clients' && /^client:/.test(ui.detail || '') && !isPhone()) {
      const a = document.activeElement;
      const cur = a && a.closest ? a.closest('#client-list [data-key^="client:"]') : null;
      if (!cur) return;
      const rows = Array.prototype.slice.call(document.querySelectorAll('#client-list [data-key^="client:"]'));
      const next = rows[rows.indexOf(cur) + (e.key === 'ArrowDown' ? 1 : -1)];
      if (!next) return;
      e.preventDefault();
      next.focus({ preventScroll: true });
      ui.detailFocus = next;
      window.openProfile(next.getAttribute('data-key').slice(7));
    }
  });

  // ── Chrome: sidebar, topbar, bar bawah ─────────────────────────────────────
  const NAV = {
    admin: [
      ['dashboard', 'layout-dashboard', 'Dashboard'],
      ['calendar', 'calendar-days', 'Jadwal'],
      ['clients', 'users', 'Klien'],
      ['coaches', 'dumbbell', 'Coach']
    ],
    // Fase X. Sidebar desktop: semua halaman. Bar bawah HP (pubTabs): Hari ini, Latihan, [+], Makan (atau Progres bila Gizi mati), Saya.
    public: [
      ['public-dashboard', 'house', 'Hari ini'],
      ['public-program', 'dumbbell', 'Latihan'],
      ['public-food', 'utensils', 'Makan'],
      ['calendar', 'calendar-days', 'Jadwal'],
      ['public-progress', 'trending-up', 'Progres'],
      ['public-more', 'user-round', 'Saya']
    ]
  };
  const PUB_SIDE_MAIN = [['public-dashboard', 'house', 'Hari ini'], ['public-program', 'dumbbell', 'Latihan'], ['public-food', 'utensils', 'Makan'], ['public-progress', 'trending-up', 'Progres'], ['calendar', 'calendar-days', 'Jadwal']];
  const PUB_SIDE_AKUN = [['public-more', 'user-round', 'Saya'], ['public-pack', 'package', 'Paket saya'], ['public-coaches', 'dumbbell', 'Coach'], ['public-info', 'megaphone', 'Info & Tips'], ['public-share', 'layout-grid', 'Kartu saya']];
  window.PUB_SIDE = function () { return PUB_SIDE_MAIN.concat(PUB_SIDE_AKUN).map(n => n[0]); };
  const nutTabOn = () => !(window.myNutrition && window.myNutrition.enabled === false);
  function pubTabs() {
    return [
      ['public-dashboard', 'house', 'Hari ini'],
      ['public-program', 'dumbbell', 'Latihan'],
      nutTabOn() ? ['public-food', 'utensils', 'Makan'] : ['public-progress', 'trending-up', 'Progres'],
      ['public-more', 'user-round', 'Saya']
    ];
  }
  // Halaman kedua → tab asalnya (tab itu menyala, tombol kembali di top bar, back Android kembali ke sana).
  const PUB_PARENT = { 'calendar': 'public-dashboard', 'public-progress': 'public-more', 'public-plan': 'public-more', 'public-pack': 'public-more',
    'public-catalog': 'public-more', 'public-coaches': 'public-more', 'public-info': 'public-more', 'public-share': 'public-more' };
  function pubParent(v) {
    if (!window.publicLoggedMember || !PUB_PARENT[v]) return '';
    if (v === 'public-progress' && !nutTabOn()) return '';   // Progres jadi tab sendiri bila Gizi mati
    return PUB_PARENT[v];
  }
  window.pubParent = pubParent;
  const TITLES = {
    'dashboard': 'Dashboard', 'calendar': 'Jadwal', 'clients': 'Klien', 'coaches': 'Coach', 'finance': 'Keuangan', 'settings': 'Pengaturan', 'content': 'Konten',
    'public-login': 'Masuk member', 'public-dashboard': 'Hari ini', 'public-catalog': 'Paket', 'public-coaches': 'Coach',
    'public-progress': 'Progres', 'public-program': 'Latihan', 'public-info': 'Info & Tips', 'public-more': 'Saya', 'public-share': 'Kartu saya',
    'public-food': 'Makan', 'public-plan': 'Rencana makan', 'public-pack': 'Paket saya'
  };

  // Menu untuk pengunjung yang belum login: hanya yang boleh dilihat tanpa akun.
  const GUEST_NAV = [
    ['public-login', 'log-in', 'Masuk'],
    ['calendar', 'calendar-days', 'Jadwal'],
    ['public-catalog', 'package', 'Paket'],
    ['public-coaches', 'dumbbell', 'Coach']
  ];
  function isGuest() { return ui.mode === 'public' && !window.publicLoggedMember; }

  function buildChrome() {
    ui.chromeGuest = isGuest();
    ui.chromeNut = nutTabOn();
    const items = ui.chromeGuest ? GUEST_NAV : (ui.mode === 'public' && !ui.chromeNut ? NAV.public.filter(n => n[0] !== 'public-food') : NAV[ui.mode]);
    const sideItems = items.concat(ui.mode === 'admin' ? [['content', 'megaphone', 'Konten']] : []).concat(ui.mode === 'admin' && finOn() ? [['finance', 'wallet', 'Keuangan']] : []);
    const navBtn = function (n) {
      return '<button type="button" class="nav-item" data-view="' + n[0] + '" title="' + n[2] + '" onclick="window.navigate(\'' + n[0] + '\')">' +
        icon(n[1]) + '<span class="nav-label">' + n[2] + '</span>' +
        (n[0] === 'calendar' && ui.mode === 'admin' ? '<span class="nav-badge hide" id="nav-unread-badge"></span>' : '') + '</button>';
    };
    // Fase Y: sidebar portal (tablet/laptop/PC) seperti aplikasi Mac — grup utama + grup Akun; HP tidak memakai sidebar.
    const pubSide = ui.mode === 'public' && !ui.chromeGuest;
    setHTML('side-nav', pubSide
      ? PUB_SIDE_MAIN.filter(n => ui.chromeNut || n[0] !== 'public-food').map(navBtn).join('') + '<p class="nav-group">Akun</p><span class="nav-rule" aria-hidden="true"></span>' + PUB_SIDE_AKUN.filter(n => n[0] !== 'public-share' || window.shareOn !== false).map(navBtn).join('')
      : sideItems.map(navBtn).join(''));

    const foot = pubSide
      ? '<button type="button" class="side-me" id="side-me" onclick="window.navigate(\'public-more\')" title="Saya">' + avatar(window.publicLoggedMember.photo, window.publicLoggedMember.name, 'sm') +
        '<span class="side-me-text"><b>' + h(String(window.publicLoggedMember.name || '').split(' ')[0]) + '</b><span id="side-me-lv"></span></span></button>' +
        '<button type="button" class="nav-item hide" id="side-auth-btn" onclick="window.logoutCurrent()">' + icon('log-out') + '<span class="nav-label">Keluar</span></button>'
      : ui.mode === 'admin'
      ? '<button type="button" class="nav-item" data-view="settings" onclick="window.navigate(\'settings\')">' + icon('settings') + '<span class="nav-label">Pengaturan</span></button>'
      : '<button type="button" class="nav-item" onclick="window.openSettings()">' + icon('sun-moon') + '<span class="nav-label">Tampilan</span></button>' +
        '<button type="button" class="nav-item" id="side-auth-btn" onclick="window.logoutCurrent()">' + icon('log-out') + '<span class="nav-label">Keluar</span></button>';
    setHTML('side-foot', foot);

    const t = ui.mode === 'public' && !ui.chromeGuest ? pubTabs() : items;
    const groupOf = v => ui.mode === 'public' && !ui.chromeGuest ? Object.keys(PUB_PARENT).filter(k => pubParent(k) === v) : [];
    const tab = function (n) {
      const grp = groupOf(n[0]);
      return '<button type="button" class="tab" data-view="' + n[0] + '"' + (grp.length ? ' data-group="' + grp.join(' ') + '"' : '') + ' onclick="window.navigate(\'' + n[0] + '\')" aria-label="' + n[2] + '">' +
        icon(n[1]) + '<span>' + n[2] + '</span>' + (n[0] === 'calendar' && ui.mode === 'admin' ? '<span class="tab-dot hide" id="tab-unread-dot"></span>' : '') +
        (n[0] === 'public-more' ? '<span class="tab-dot-new hide" id="tab-more-new"></span>' : '') + '</button>';
    };
    const fab = ui.mode === 'admin'
      ? '<button type="button" class="tab-fab" id="client-booking-fab" onclick="window.openSheet(\'sheet-quick\')" aria-label="Tambah cepat">' + icon('plus') + '</button>'
      : '<button type="button" class="tab-fab" id="client-booking-fab" onclick="window.clientPlus()" aria-label="Booking atau mulai latihan">' + icon('plus') + '</button>';
    setHTML('tabbar', tab(t[0]) + tab(t[1]) + fab + tab(t[2]) + tab(t[3]));
    renderTopbarActions();
    renderThemeSeg();
    finTiles();
    if (ui.mode === 'public' && window.renderInfoDotsLate) window.renderInfoDotsLate();
    const sa = $('settings-admin');
    if (sa) sa.classList.toggle('hide', ui.mode !== 'admin');
  }

  function renderTopbarActions() {
    let html = '';
    if (ui.mode === 'admin') {
      html += '<button type="button" class="icon-btn" id="notification-btn" onclick="window.openNotificationModal()" aria-label="Booking baru">' + icon('bell') + '<span class="badge-dot hide" id="unread-badge"></span></button>';
      html += '<button type="button" class="icon-btn only-mobile" onclick="window.openSettings()" aria-label="Pengaturan">' + icon('settings') + '</button>';
    } else {
      if (!window.publicLoggedMember) {
        html += '<button type="button" class="icon-btn only-mobile" onclick="window.openSettings()" aria-label="Tampilan">' + icon('sun-moon') + '</button>';
        html += '<button type="button" class="btn btn-primary btn-sm" id="nav-login-btn" onclick="window.navigate(\'public-login\')">Masuk</button>';
      } else {
        const nc = window.notifCount ? window.notifCount() : 0;
        if (window.deskIs && window.deskIs()) html += window.deskToolsHtml(window.currentView) + '<button type="button" class="icon-btn" id="nav-plus-btn" onclick="window.clientPlus(this)" aria-label="Tambah">' + icon('plus') + '</button>';
        html += '<button type="button" class="icon-btn on-band" id="nav-bell-btn" onclick="window.openNotif()" aria-label="Pemberitahuan' + (nc ? ', ' + nc + ' baru' : '') + '">' + icon('bell') + '<span class="badge-dot' + (nc ? '' : ' hide') + '" id="bell-count">' + nc + '</span></button>';
        html += '<button type="button" class="icon-btn" id="nav-dashboard-btn" onclick="window.navigate(\'public-more\')" aria-label="Saya">' + avatar(window.publicLoggedMember.photo, window.publicLoggedMember.name, 'sm') + '</button>';
      }
    }
    setHTML('topbar-actions', html);
    if (ui.mode === 'public' && (ui.chromeGuest !== isGuest() || ui.chromeNut !== nutTabOn())) { buildChrome(); return; }
    const sideAuth = $('side-auth-btn');
    if (sideAuth) sideAuth.classList.toggle('hide', !window.publicLoggedMember);
    updateBadges();
  }

