
  // ── Fase X: portal klien baru (Hari ini, tab Saya, lonceng, tombol ＋) ───────
  // window.myX = { profile, level, moments, journey, notif, todo } dari getPortalMore (dihitung di server, lihat Level.gs).
  window.myX = {};
  const X = () => window.myX || {};
  // Warna aksen pilihan klien berlaku di seluruh portal; 'hitam' (bawaan) = tanpa atribut.
  window.applyAccent = function () {
    const a = ui.mode === 'public' && window.publicLoggedMember && X().profile ? X().profile.aksen : '';
    if (a && a !== 'hitam') document.documentElement.setAttribute('data-accent', a); else document.documentElement.removeAttribute('data-accent');
  };
  const BADGE_CODE = { 'sesi-10': '10', 'sesi-25': '25', 'sesi-50': '50', 'sesi-100': '100', 'streak-4': '4W', 'streak-8': '8W', 'streak-12': '12W', 'catat-5': 'L5', 'catat-20': 'L20', 'pr-1': 'PR', 'pr-10': 'P10' };
  function shieldSvg(id, label, on) {
    return '<svg class="shield' + (on ? ' on' : '') + '" viewBox="0 0 48 52" role="img" aria-label="' + h(label || id) + '"><path d="M4 2h40v30L24 50 4 32z"/><text x="24" y="28" text-anchor="middle">' + h(BADGE_CODE[id] || '★') + '</text></svg>';
  }
  const localIso = d => d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());

  // ── Tugas hari ini ──
  function todoHtml() {
    const t = X().todo;
    if (!t) return '<div class="px-sec"><h3>Tugas hari ini</h3></div><div class="card">' + skel(3, true) + '</div>';
    const done = t.filter(x => x.done).length;
    let html = '<div class="px-sec"><h3>Tugas hari ini</h3>' + (t.length ? '<span>' + done + ' dari ' + t.length + ' selesai</span>' : '') + '</div>';
    if (!t.length) return html + '<div class="card">' + emptyState('check-check', 'Semua beres', 'Tidak ada tugas untuk hari ini.') + '</div>';
    html += '<div class="px-bar" aria-hidden="true"><i style="width:' + Math.round(done / t.length * 100) + '%"></i></div><div class="card todo">';
    t.forEach(function (x) {
      const txt = '<span class="todo-txt"><span class="todo-title">' + h(x.title) + '</span>' + (x.sub ? '<span class="todo-sub">' + h(x.sub) + '</span>' : '') + '</span>';
      if (x.done) { html += '<div class="todo-row done"><span class="todo-check">' + icon('check') + '</span>' + txt + '</div>'; return; }
      html += '<button type="button" class="todo-row' + (x.danger ? ' danger' : '') + '" data-id="' + h(x.id) + '" data-ref="' + h(x.ref || '') + '" onclick="window.todoGo(this.dataset.id,this.dataset.ref)">' +
        '<span class="todo-check"></span>' + txt + (x.act ? '<span class="todo-act">' + h(x.act) + '</span>' : icon('chevron-right')) + '</button>';
    });
    return html + '</div>';
  }
  window.todoGo = function (id, ref) {
    const kind = String(id).split(':')[0];
    if (kind === 'latihan') window.workoutOpenClient(ref || undefined);
    else if (kind === 'makan') window.navigate('public-food');
    else if (kind === 'gizi-data') window.openNutOnb();
    else if (kind === 'pr') window.openTaskDone(ref);
    else if (kind === 'booking') window.handleFabClick();
    else if (kind === 'nilai') { const el = $('pub-feedback-slot'); if (el) el.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
    else if (kind === 'evaluasi') window.openPackageEval();
    else if (kind === 'perpanjang') window.openRenewSheet();
    else if (kind === 'tagihan') window.navigate('public-pack');
  };

  // ── Strip minggu ini: sesi coach atau latihan tercatat = penuh, sesi terjadwal = setengah ──
  function weekStripHtml() {
    const me = window.publicLoggedMember, now = new Date(), today = localIso(now);
    const mon = new Date(now.getFullYear(), now.getMonth(), now.getDate() - ((now.getDay() + 6) % 7));
    const lvl = {};
    window.schedules.filter(s => String(s.memberId) === String(me.id)).forEach(function (s) { const k = localIso(new Date(s.start)); lvl[k] = Math.max(lvl[k] || 0, isDone(s) ? 2 : 1); });
    const w = window.myWorkout && window.myWorkout.state === 'ok' ? window.myWorkout.data : null;
    ((w && w.days) || []).forEach(function (d) { lvl[d.tanggal] = 2; });
    const wk = window.myWeek && !window.myWeek.error ? window.myWeek : null;
    const sum = wk ? wk.sessionsDone + ' sesi · ' + wk.workoutDays + ' latihan' + (wk.foodDays != null ? ' · makan ' + wk.foodDays + '/7' : '') : '';
    let html = '<div class="px-sec"><h3>Minggu ini</h3><span>' + h(sum) + '</span></div><div class="week-x" style="margin-top:12px">';
    ['Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab', 'Min'].forEach(function (n, i) {
      const k = localIso(new Date(mon.getFullYear(), mon.getMonth(), mon.getDate() + i)), l = lvl[k] || 0;
      html += '<div class="' + (l ? 'l' + l : '') + (k === today ? ' now' : '') + '"><i></i>' + n + '</div>';
    });
    return html + '</div>';
  }

  // ── Hari ini ──
  window.renderPublicDashboard = function () {
    const el = $('view-public-dashboard'), me = window.publicLoggedMember;
    if (!el || !me) return;
    const total = Number(me.totalSessions) || 0, rem = Math.max(0, total - (Number(me.usedSessions) || 0));
    const mine = window.schedules.filter(s => String(s.memberId) === String(me.id));
    const next = mine.filter(s => !isDone(s) && new Date(s.end || s.start) > new Date()).sort(byStart)[0];
    let html = '<div class="px-band gfx-kontur"><p class="px-date">' + h(fmtDate(new Date())) + '</p></div>';
    html += '<section class="card-ink gfx-geo next-x px-hang" id="pub-next-session-card"' + (next ? ' data-start="' + h(next.start) + '"' : '') + '>' +
      '<div class="ih-head"><span class="ih-eyebrow">Sesi berikutnya</span>' + (next ? statusInfo(next).pill : '') + '</div>';
    const calBtn = next ? '<button type="button" class="btn btn-on-ink-ghost nx-ico" id="pub-next-cal" onclick="window.openAddToCalendar([\'' + h(next.id) + '\'])" aria-label="Tambah ke kalender">' + icon('calendar-plus') + '</button>' : '';
    if (next) {
      const d = new Date(next.start);
      html += '<p class="nx-when" id="pub-next-session-label">' + h(fmtDate(d)) + ' · ' + fmtTime(d) + '</p>' +
        '<p class="nx-count num" id="pub-next-countdown" data-countdown-long="' + d.getTime() + '">' + h(countdownText(d)) + '</p>' +
        (window.isSoloCoach() ? '' : '<p class="li-sub" style="margin-top:6px">' + h(next.coachName || 'Menunggu coach') + '</p>') +
        '<div class="nx-actions"><button type="button" class="btn btn-on-ink-ghost" onclick="window.openRescheduleModal(\'' + h(next.id) + '\')">' + icon('calendar-clock') + 'Ubah</button>' +
        '<button type="button" class="btn btn-on-ink" id="pub-all-sched" onclick="window.navigate(\'calendar\')">' + icon('calendar-days') + 'Jadwal</button>' + calBtn + '</div>';
    } else {
      html += '<p class="nx-when">Belum ada jadwal</p><p class="li-sub" style="margin-top:6px;max-width:calc(100% - 96px)">' + (total && !rem ? 'Sesi paket ini sudah habis.' : 'Pilih hari dan jam untuk sesi berikutnya.') + '</p>' +
        '<div class="nx-actions"><button type="button" class="btn btn-on-ink" onclick="window.handleFabClick()">' + icon('calendar-plus') + 'Booking sesi</button>' +
        '<button type="button" class="btn btn-on-ink-ghost" onclick="window.navigate(\'calendar\')">' + icon('calendar-days') + 'Jadwal</button></div>';
    }
    html += '</section>';
    html += '<div id="pub-feedback-slot">' + feedbackCardHtml() + '</div>';
    html += '<div class="px-stack" style="gap:10px" id="pub-todo">' + todoHtml() + '</div>';
    html += '<div class="card" id="pub-weekx">' + weekStripHtml() + '</div>';
    // Kartu paket: sisa sesi + status perpanjangan (peringatan sisa sedikit, menunggu konfirmasi, sudah diperpanjang) + tagihan.
    html += '<section class="card-ink gfx-kontur" id="pub-pack-card"><div class="ih-head"><span class="ih-eyebrow">' + h(me.packageName || 'Paket') + '</span>' +
      '<button type="button" class="link-btn" style="color:inherit" onclick="window.navigate(\'public-pack\')">Paket saya' + icon('chevron-right') + '</button></div>' +
      (total ? '<p style="font-size:var(--fs-2xl);font-weight:800;letter-spacing:-0.02em;margin-top:8px">Sisa <span id="pub-dash-remaining">' + rem + '</span> dari <span id="pub-dash-total">' + total + '</span> sesi</p>' : '') +
      '<div id="pub-renew-slot">' + renewNoticeHtml(rem, total) + '</div><div id="pub-bill-slot"></div></section>';
    html += '<div class="card hide" id="pub-today-wl"></div>';
    setHTML(el, '<div class="px-wrap px-stack">' + html + '</div>');
    renderTodayWorkout(); renderBillSlot();
  };

  // ── Tab Saya: kartu atlet + kisi ──
  function athleteCardHtml(opts) {
    const me = window.publicLoggedMember, p = X().profile, lv = X().level;
    const nama = (p && p.nama) || String(me.name || '').split(' ')[0];
    let html = '<section class="card-ink athlete gfx-tipo st-' + h((p && p.gaya) || 'polos') + (opts && opts.hang ? ' px-hang' : '') + '" id="pub-athlete" aria-label="Kartu atlet" data-tipo="' + (lv ? 'LV' + lv.level : 'XNK') + '">';
    if (lv) html += '<span class="ath-ribbon" aria-hidden="true">' + h(lv.gelar) + '</span>';
    html += '<div class="ath-head"><button type="button" class="ath-photo" id="pub-avatar-btn" onclick="document.getElementById(\'pub-avatar-input\').click()" aria-label="Ganti foto profil">' +
      (me.photo ? '<img src="' + h(me.photo) + '" alt="" id="pub-avatar-img">' : h(initials(me.name))) + '</button>' +
      '<div style="min-width:0"><p class="ath-name" id="pub-dash-name">' + h(nama) + '</p>' + (p && p.motto ? '<p class="ath-motto">“' + h(p.motto) + '”</p>' : '<p class="ath-motto">' + h(me.packageName || 'Member XNK') + '</p>') + '</div></div>';
    if (lv) {
      html += '<div><div class="ath-lvl"><b>Level ' + lv.level + ' · ' + h(lv.gelar) + '</b><span>' + (lv.sampai ? lv.poin + ' / ' + lv.sampai + ' poin' : lv.poin + ' poin') + '</span></div>' +
        '<div class="px-bar" style="margin-top:8px" role="img" aria-label="' + lv.pct + ' persen menuju level berikutnya"><i style="width:' + lv.pct + '%"></i></div></div>';
    } else html += skel(2);
    if (p) {
      const by = {}; p.statOptions.forEach(o => { by[o.k] = o; });
      html += '<div class="ath-stats">' + p.stat.filter(k => by[k]).map(k => '<div><b class="num">' + h(by[k].v) + '</b><span>' + h(by[k].l) + '</span></div>').join('') + '</div>';
      const badges = (pg.data && pg.data.badges) || [];
      const pick = p.badge.length ? p.badge : badges.filter(b => b.earned).slice(-3).map(b => b.id);
      if (pick.length) html += '<div class="ath-badges">' + pick.map(function (id) { const b = badges.find(x => x.id === id); return shieldSvg(id, b ? b.label : id, true); }).join('') + '</div>';
    }
    if (!opts || opts.actions !== false) {
      html += '<div class="nx-actions" style="margin-top:0"><button type="button" class="btn btn-on-ink-ghost" id="pub-athlete-edit" onclick="(window.openProfileEdit || window.openMyProfile)()">' + icon('pencil') + 'Ubah</button>' +
        (window.shareOn !== false ? '<button type="button" class="btn btn-on-ink" onclick="window.navigate(\'public-share\')">' + icon('share-2') + 'Bagikan</button>' : '') + '</div>';
    }
    return html + '</section>';
  }
  function renderPublicMore() {
    const el = $('view-public-more'), me = window.publicLoggedMember;
    if (!el || !me) return;
    const total = Number(me.totalSessions) || 0, rem = Math.max(0, total - (Number(me.usedSessions) || 0));
    const w = pg.data && pg.data.summary && pg.data.summary.berat;
    const tile = (onclick, ic, title, sub, extra) => '<button type="button" class="px-tile" onclick="' + onclick + '">' + icon(ic) + '<b>' + h(title) + '</b>' + (sub ? '<span' + (extra === 'warn' ? ' class="warn"' : '') + '>' + h(sub) + '</span>' : '') + (extra && extra !== 'warn' ? extra : '') + '</button>';
    const go = v => 'window.navigate(\'' + v + '\')';
    const next = window.schedules.filter(s => String(s.memberId) === String(me.id) && !isDone(s) && new Date(s.end || s.start) > new Date()).sort(byStart)[0];
    let tiles = '';
    if (nutTabOn()) tiles += tile(go('public-progress'), 'trending-up', 'Progres', w ? String(w.last.nilai).replace('.', ',') + ' kg' : 'Berat, ukuran, tes');
    tiles += tile(go('public-pack'), 'package', 'Paket saya', total ? 'Sisa ' + rem + ' dari ' + total + ' sesi' : (me.packageName || 'Lihat paket'), total && rem <= 2 ? 'warn' : '');
    tiles += tile(go('calendar'), 'calendar-days', 'Jadwal', next ? fmtDate(new Date(next.start), { weekday: 'short', day: 'numeric', month: 'short' }) + ' · ' + fmtTime(new Date(next.start)) : 'Belum ada jadwal');
    tiles += tile(go('public-coaches'), 'dumbbell', 'Coach', 'Profil, jam, chat');
    if (nutTabOn()) tiles += tile(go('public-plan'), 'utensils', 'Rencana makan', 'Menu, belanja, angka tubuh');
    if (window.shareOn !== false) tiles += tile(go('public-share'), 'layout-grid', 'Kartu saya', 'Bagikan latihan dan progres');
    tiles += tile(go('public-info'), 'megaphone', 'Info & Tips', 'Dari coach', '<span class="new-dot' + (infoHasNew() ? '' : ' hide') + '" id="more-info-dot" aria-label="Baru"></span>');
    tiles += tile('window.openSettings()', 'sun-moon', 'Tampilan', 'Terang, gelap');
    tiles += tile('window.openMyProfile()', 'user-round', 'Data akun', 'Nama, email, foto');
    setHTML(el, '<div class="px-wrap px-stack"><div class="px-band gfx-kontur"></div>' + athleteCardHtml({ hang: true }) +
      '<div class="px-tiles">' + tiles + '</div>' +
      '<button type="button" class="btn btn-ghost btn-block" onclick="window.logoutCurrent()">' + icon('log-out') + 'Keluar</button></div>');
  }

  // ── Lonceng ──
  const NOTIF_KIND = { info: 'Info dari coach', data: 'Ukur & isi data', paket: 'Paket & jadwal', capai: 'Pencapaian' };
  window.notifCount = function () { return (X().notif && X().notif.count) || 0; };
  function notifHtml() {
    const n = X().notif;
    if (!n) return skel(3, true);
    if (!n.items.length) return emptyState('bell', 'Belum ada pemberitahuan', 'Info dari coach, pengingat, dan pencapaian muncul di sini.');
    const row = function (x) {
      return '<button type="button" class="notif-row' + (x.fresh ? ' fresh' : '') + '" data-id="' + h(x.id) + '" onclick="window.notifGo(this.dataset.id)">' + (x.fresh ? '<span class="nf-dot" aria-label="Baru"></span>' : '') +
        '<span class="nf-txt"><span class="nf-kind">' + h(NOTIF_KIND[x.kind] || '') + '</span><b>' + h(x.title) + '</b>' + (x.sub ? '<span class="nf-sub">' + h(x.sub) + '</span>' : '') + '</span>' +
        (x.fresh && x.act ? '<span class="nf-act">' + h(x.act) + '</span>' : '') + '</button>';
    };
    const fresh = n.items.filter(x => x.fresh), old = n.items.filter(x => !x.fresh);
    return '<div class="notif-list">' + (fresh.length ? '<p class="px-eyebrow">Baru</p>' + fresh.map(row).join('') : '') +
      (old.length ? '<p class="px-eyebrow"' + (fresh.length ? ' style="margin-top:8px"' : '') + '>Sebelumnya</p>' + old.map(row).join('') : '') + '</div>';
  }
  window.openNotif = function () {
    setHTML('notif-body', notifHtml());
    openSheet('sheet-notif');
    const n = X().notif;
    if (!n || !n.count) return;
    n.count = 0; n.items.forEach(function (x) { x.fresh = false; });   // objek yang sama dengan salinan di perangkat: buka berikutnya tidak menghitung lagi
    renderTopbarActions(); savePortalCache();
    memberCall('markNotifSeen').catch(function () {});
  };
  window.notifGo = function (id) {
    const kind = String(id).split(':')[0];
    window.closeModal();
    setTimeout(function () {
      if (kind === 'info') window.navigate('public-info');
      else if (kind === 'ukur') window.pgOpenEntry('member');
      else if (kind === 'gizi-data') window.openNutOnb();
      else if (kind === 'kesehatan') window.openPortalHealth();
      else if (kind === 'paket' || kind === 'tagihan') window.navigate('public-pack');
      else if (kind === 'capai') window.navigate('public-progress');
    }, 320);
  };

  // ── Tombol ＋: empat aksi ──
  window.clientPlus = function () {
    if (!window.isPublicView || !window.publicLoggedMember) { window.handleFabClick(); return; }
    const me = window.publicLoggedMember, total = Number(me.totalSessions) || 0, rem = Math.max(0, total - (Number(me.usedSessions) || 0));
    const w = window.myWorkout && window.myWorkout.state === 'ok' ? window.myWorkout.data : null;
    const n = window.myNutrition, t = n && n.target, eaten = n && n.log && n.log.totals ? n.log.totals.kal : 0;
    const tile = (kind, ic, title, sub, ink) => '<button type="button" class="px-tile' + (ink ? ' ink' : '') + '" onclick="window.clientQuick(\'' + kind + '\')">' + icon(ic) + '<b>' + h(title) + '</b><span>' + h(sub) + '</span></button>';
    setHTML('quick-client-body', '<div class="px-tiles">' +
      tile('booking', 'calendar-plus', 'Booking sesi', total ? 'Sisa ' + rem + ' sesi' : 'Pilih hari dan jam', true) +
      tile('workout', 'dumbbell', 'Mulai latihan', w && w.next ? 'Berikutnya: ' + w.next : 'Rutinitas atau kosong') +
      (nutTabOn() ? tile('food', 'utensils', 'Catat makan', t && t.ok ? 'Sisa ' + Math.max(0, Math.round(t.kal - eaten)) + ' kkal' : 'Buku harian makan') : '') +
      tile('measure', 'scale', 'Catat ukuran', 'Berat dan lingkar badan') + '</div>' +
      '<button type="button" class="btn btn-ghost btn-block" style="margin-top:12px" onclick="window.clientQuick(\'past\')">' + icon('calendar-check') + 'Catat latihan yang lewat</button>');
    openSheet('sheet-quick-client');
  };
  window.clientQuick = function (kind) {
    window.closeModal();
    setTimeout(function () {
      if (kind === 'booking') window.handleFabClick();
      else if (kind === 'past') window.workoutOpenClient(undefined, true);
      else if (kind === 'food') { window.navigate('public-food'); if (window.myNutrition && window.myNutrition.target && window.myNutrition.target.ok) setTimeout(function () { window.openNutAdd(); }, 200); }
      else if (kind === 'measure') window.pgOpenEntry('member');
      else window.workoutOpenClient(undefined);
    }, 120);
  };

  // ── Makan, Rencana makan, Paket saya (halaman sendiri) ──
  window.renderPublicFood = function () {
    const el = $('view-public-food');
    if (!el || !window.publicLoggedMember) return;
    setHTML(el, '<div id="pub-makan-pane">' + makanInner() + '</div>');
  };
  window.renderPublicPlan = function () { window.navigate('public-food'); };
  window.renderPublicPack = function () { window.navigate('public-catalog'); };

  // Gambar ulang bagian Fase X yang sedang tampil (dipanggil tiap data portal berubah).
  window.renderPortalX = function () {
    const td = $('pub-todo'); if (td) setHTML(td, todoHtml());
    const wk = $('pub-weekx'); if (wk) setHTML(wk, weekStripHtml());
    if (window.currentView === 'public-more' && $('pub-athlete')) renderPublicMore();
    if (ui.mode === 'public') renderTopbarActions();
  };

  // ── Semua jadwal: daftar sesi sendiri di bawah kalender (Mendatang, Selesai) ──
  window.mySessionListsHtml = function () {
    const me = window.publicLoggedMember; if (!me) return '';
    const mine = window.schedules.filter(s => String(s.memberId) === String(me.id));
    const up = mine.filter(s => !isDone(s) && new Date(s.end || s.start) > new Date()).sort(byStart);
    const past = mine.filter(s => up.indexOf(s) === -1).sort((a, b) => new Date(b.start) - new Date(a.start));
    return '<div class="card"><div class="px-sec" style="margin-bottom:8px"><h3>Mendatang</h3><span>' + up.length + ' sesi</span></div>' +
      (up.length ? '<div class="list" id="pub-upcoming-list">' + up.map(memberSessionRow).join('') + '</div>' : '<p class="li-sub">Belum ada jadwal mendatang.</p>') + '</div>' +
      '<div class="card"><div class="px-sec" style="margin-bottom:8px"><h3>Selesai</h3><span>' + past.length + ' sesi</span></div>' +
      (past.length ? '<div class="list" id="pub-sched-history">' + past.slice(0, 8).map(memberSessionRow).join('') + '</div>' : '<p class="li-sub">Riwayat sesi muncul di sini.</p>') + '</div>';
  };

  // ── Booking tiga langkah (Fase X): Coach (hanya 2+ coach) → Hari → Jam → Periksa ──
  // Layar ini hanya memilih; pengiriman tetap lewat form booking yang ada (optimistis, bentrok → saran jam, seri mingguan).
  const bkx = { steps: [], i: 0, coach: '', date: '', time: '', month: '', repeat: false, resched: '' };
  const bkMulti = () => !window.isSoloCoach() && window.coaches.length > 1;
  function bkMap() { return (bkMulti() ? window.openSlotsByCoachMap[bkx.coach] : window.openSlotsByDate) || {}; }
  function bkFreeHours(date) { const f = bkMap()[date] || {}; return Object.keys(f).map(Number).filter(hh => f[hh] > 0).sort((a, b) => a - b); }
  const bkDayLabel = date => { const p = date.split('-').map(Number); return fmtDate(new Date(p[0], p[1] - 1, p[2])); };
  window.bkOpen = function (opts) {
    opts = opts || {};
    const me = window.publicLoggedMember;
    if (!me) { window.showToast('Masuk dulu untuk booking jadwal.', 'lock'); window.navigate('public-login'); return; }
    let old = null;
    if (opts.resched) {
      old = window.schedules.find(x => String(x.id) === String(opts.resched));
      if (!old || String(old.memberId) !== String(me.id)) { window.showToast('Jadwal tidak ditemukan.'); return; }
      if (isDone(old)) { window.showToast('Sesi yang sudah selesai tidak bisa diubah.'); return; }
      const cutoff = window.rescheduleCutoffHours != null ? Number(window.rescheduleCutoffHours) : 2;
      if ((new Date(old.start) - new Date()) / 3600000 < cutoff) { window.showToast('Ubah jadwal paling lambat ' + cutoff + ' jam sebelum sesi. Hubungi coach lewat WhatsApp.', 'clock'); return; }
    }
    const multi = bkMulti();
    Object.assign(bkx, { steps: (multi && !old ? ['coach'] : []).concat(['hari', 'jam', 'cek']), i: 0, repeat: false, resched: old ? String(old.id) : '',
      coach: multi ? String((old && old.coachId) || ui.bookCoach || '') : '', date: opts.date || '', time: opts.time || '' });
    if (bkx.date && bkx.time) bkx.i = bkx.steps.indexOf('cek');
    else if (bkx.coach && bkx.steps[0] === 'coach') bkx.i = 1;
    bkx.month = (bkx.date || wibParts(new Date()).date).slice(0, 7);
    ui.bkOn = true;
    const el = $('bk-screen');
    el.classList.remove('hide');
    requestAnimationFrame(function () { el.classList.add('open'); });
    bkDraw();
    syncBack();
    if (window.refreshOpenSlots) window.refreshOpenSlots();
  };
  function bkHide(noSync) {
    ui.bkOn = false;
    const el = $('bk-screen');
    el.classList.remove('open');
    setTimeout(function () { if (!ui.bkOn) el.classList.add('hide'); }, 260);
    if (!noSync) syncBack();
  }
  window.bkClose = function () { bkHide(); };
  window.bkBack = function () { const first = bkx.date && bkx.time && bkx.steps[bkx.i] === 'cek' && !bkx.walked; if (bkx.i > 0 && !first) { bkx.i--; bkDraw(); } else bkHide(); };
  window.bkNext = function () {
    const st = bkx.steps[bkx.i];
    if (st === 'coach' && !bkx.coach) { window.showToast('Pilih coach dulu.'); return; }
    if (st === 'hari' && !bkx.date) { window.showToast('Pilih hari dulu.'); return; }
    if (st === 'jam' && !bkx.time) { window.showToast('Pilih jam dulu.'); return; }
    if (st === 'cek') { bkSubmit(); return; }
    bkx.walked = true; bkx.i++; bkDraw();
  };
  window.bkPick = function (kind, v) {
    if (kind === 'coach') { bkx.coach = String(v); bkx.date = ''; bkx.time = ''; ui.bookCoach = bkx.coach; if (window.refreshOpenSlots) window.refreshOpenSlots(); }
    else if (kind === 'hari') { if (bkx.date !== v) bkx.time = ''; bkx.date = v; }
    else if (kind === 'jam') bkx.time = v;
    else if (kind === 'bulan') bkx.month = v;
    else if (kind === 'ulang') bkx.repeat = !bkx.repeat;
    bkDraw();
  };
  function bkCalHtml() {
    const map = bkMap(), dates = Object.keys(map).sort();
    if (!dates.length) return '<div class="card">' + skel(3, true) + '</div>';
    const first = dates[0].slice(0, 7), last = dates[dates.length - 1].slice(0, 7);
    if (bkx.month < first) bkx.month = first; if (bkx.month > last) bkx.month = last;
    const y = Number(bkx.month.slice(0, 4)), m = Number(bkx.month.slice(5, 7));
    const step = d => { const x = new Date(y, m - 1 + d, 1); return x.getFullYear() + '-' + pad(x.getMonth() + 1); };
    const nav = (d, label, ic) => { const to = step(d), ok = to >= first && to <= last; return '<button type="button" class="icon-btn plain"' + (ok ? ' onclick="window.bkPick(\'bulan\',\'' + to + '\')"' : ' disabled') + ' aria-label="' + label + '">' + icon(ic) + '</button>'; };
    let cells = '';
    const lead = (new Date(y, m - 1, 1).getDay() + 6) % 7, days = new Date(y, m, 0).getDate(), today = wibParts(new Date()).date;
    for (let i = 0; i < lead; i++) cells += '<span></span>';
    for (let d = 1; d <= days; d++) {
      const k = bkx.month + '-' + pad(d), free = bkFreeHours(k).length;
      if (!free) cells += '<span class="bk-day off' + (k === today ? ' today' : '') + '">' + d + '</span>';
      else cells += '<button type="button" class="bk-day' + (k === bkx.date ? ' on' : '') + (k === today ? ' today' : '') + '" aria-pressed="' + (k === bkx.date) + '" aria-label="' + h(bkDayLabel(k)) + ', ' + free + ' jam kosong" onclick="window.bkPick(\'hari\',\'' + k + '\')">' + d + '</button>';
    }
    return '<div class="card bk-cal"><div class="row-between">' + nav(-1, 'Bulan sebelumnya', 'chevron-left') + '<b>' + MONTHS[m - 1] + ' ' + y + '</b>' + nav(1, 'Bulan berikutnya', 'chevron-right') + '</div>' +
      '<div class="bk-dow" aria-hidden="true"><span>Sen</span><span>Sel</span><span>Rab</span><span>Kam</span><span>Jum</span><span>Sab</span><span>Min</span></div><div class="bk-grid">' + cells + '</div>' +
      '<p class="li-sub" style="margin-top:10px">Angka abu-abu: sudah lewat, penuh, atau belum dibuka.</p></div>';
  }
  function bkHoursHtml() {
    const f = bkMap()[bkx.date] || {}, hours = Object.keys(f).map(Number).sort((a, b) => a - b);
    const groups = [['Pagi', 0, 11], ['Siang', 11, 15], ['Sore', 15, 18], ['Malam', 18, 24]];
    let html = '';
    groups.forEach(function (g) {
      const hs = hours.filter(hh => hh >= g[1] && hh < g[2]);
      if (!hs.length) return;
      html += '<div><p class="px-eyebrow" style="margin-bottom:8px">' + g[0] + '</p><div class="bk-slots">' + hs.map(function (hh) {
        const t = pad(hh) + ':00', label = pad(hh) + '.00';
        return f[hh] > 0 ? '<button type="button" class="bk-slot' + (t === bkx.time ? ' on' : '') + '" aria-pressed="' + (t === bkx.time) + '" onclick="window.bkPick(\'jam\',\'' + t + '\')">' + label + '</button>'
          : '<button type="button" class="bk-slot off" disabled aria-label="' + label + ' penuh">' + label + '</button>';
      }).join('') + '</div></div>';
    });
    return html || emptyState('calendar-x', 'Tidak ada jam kosong', 'Pilih hari lain.');
  }
  function bkDraw() {
    const me = window.publicLoggedMember, st = bkx.steps[bkx.i], n = bkx.steps.length;
    const old = bkx.resched ? window.schedules.find(x => String(x.id) === bkx.resched) : null;
    const total = Number(me.totalSessions) || 0, rem = Math.max(0, total - (Number(me.usedSessions) || 0));
    let body = '', cta = 'Lanjut';
    if (st === 'coach') {
      body = '<h3 class="bk-q">Pilih coach</h3><div class="px-stack" style="gap:10px">' + window.coaches.map(function (c) {
        const on = String(c.id) === bkx.coach;
        return '<button type="button" class="bk-opt' + (on ? ' on' : '') + '" aria-pressed="' + on + '" data-id="' + h(String(c.id)) + '" onclick="window.bkPick(\'coach\',this.dataset.id)">' + avatar(c.photo, c.name, 'sm') + '<b class="grow">' + h(c.name) + '</b></button>';
      }).join('') + '</div>';
    } else if (st === 'hari') {
      const free = bkx.date ? bkFreeHours(bkx.date).length : 0;
      body = '<div><h3 class="bk-q">Pilih hari</h3><p class="li-sub">' + (old ? 'Jadwal lama: ' + h(fmtDate(new Date(old.start))) + ' · ' + fmtTime(new Date(old.start)) : (total ? 'Sisa ' + rem + ' sesi di paket ini.' : 'Pilih tanggal yang masih kosong.')) + '</p></div>' + bkCalHtml() +
        (bkx.date ? '<div class="card-flat" id="bk-day-note"><b>' + h(bkDayLabel(bkx.date)) + '</b><span class="li-sub"> · ' + free + ' jam kosong</span></div>' : '');
    } else if (st === 'jam') {
      body = '<div><h3 class="bk-q">Pilih jam</h3><p class="li-sub">' + h(bkDayLabel(bkx.date)) + '</p></div>' + bkHoursHtml();
    } else {
      const hh = Number(bkx.time.slice(0, 2));
      const coach = bkx.coach ? window.coaches.find(c => String(c.id) === bkx.coach) : null;
      const kv = (k, v) => '<div class="bk-kv"><span>' + h(k) + '</span><b>' + h(v) + '</b></div>';
      body = '<h3 class="bk-q">' + (old ? 'Periksa jadwal baru' : 'Periksa lalu booking') + '</h3>' +
        '<section class="card-ink gfx-geo" id="bk-summary"><span class="ih-eyebrow">' + (old ? 'Jadwal baru' : 'Sesi latihan') + '</span>' +
        '<p class="bk-big">' + h(bkDayLabel(bkx.date)) + '</p><p class="bk-big">' + pad(hh) + '.00 – ' + pad((hh + 1) % 24) + '.00</p></section>' +
        '<div class="card" style="padding:4px 16px">' + (old ? kv('Jadwal lama', fmtDate(new Date(old.start), { weekday: 'short', day: 'numeric', month: 'short' }) + ' · ' + fmtTime(new Date(old.start))) : '') +
        (coach ? kv('Coach', coach.name) : '') + kv('Paket', me.packageName || 'Member XNK') + (total && !old ? kv('Sisa sesi', rem + ' dari ' + total) : '') + '</div>' +
        (old ? '' : '<label class="bk-check"><input type="checkbox" id="bk-repeat"' + (bkx.repeat ? ' checked' : '') + ' onchange="window.bkPick(\'ulang\')"><span>Ulangi tiap minggu di jam yang sama</span></label>') +
        '<p class="li-sub">Bila jam ini baru saja terisi, jam terdekat yang masih kosong langsung ditawarkan.</p>';
      cta = old ? 'Simpan jadwal baru' : (bkx.repeat ? 'Atur pengulangan' : 'Booking');
    }
    setHTML('bk-screen', '<header class="bk-head"><div class="row" style="gap:8px"><button type="button" class="icon-btn plain" id="bk-back" onclick="window.bkBack()" aria-label="' + (bkx.i ? 'Kembali' : 'Tutup') + '">' + icon(bkx.i ? 'arrow-left' : 'x') + '</button>' +
      '<h2 class="grow" id="bk-title">' + (old ? 'Ubah jadwal' : 'Booking sesi') + '</h2><span class="bk-count">' + (bkx.i + 1) + ' dari ' + n + '</span></div>' +
      '<div class="step-bar" style="grid-template-columns:repeat(' + n + ',minmax(0,1fr))" aria-hidden="true">' + bkx.steps.map((x, i) => '<i' + (i <= bkx.i ? ' class="on"' : '') + '></i>').join('') + '</div></header>' +
      '<div class="bk-body">' + body + '</div><footer class="bk-foot"><button type="button" class="btn btn-primary btn-lg btn-block" id="bk-next" onclick="window.bkNext()">' + cta + '</button></footer>');
    paintIcons();
  }
  window.bkRedraw = function () { if (ui.bkOn) bkDraw(); };
  // Kirim lewat form yang ada: booking tunggal dan ubah jadwal langsung dikirim; seri mingguan dilanjutkan di form (pilih hari dan jumlah sesi).
  function bkSubmit() {
    const b = Object.assign({}, bkx);
    bkHide(true);   // riwayat back: lapisan booking langsung digantikan sheet (satu syncBack di bawah), supaya tidak ada history.go yang tertunda
    if (b.resched) { openRescheduleSheet(b.resched); if (!window.isRescheduleMode) { syncBack(); return; } }
    else {
      if (b.coach) ui.bookCoach = b.coach;
      window.openBookingSheet({ date: b.date, time: b.time });
    }
    syncBack();
    $('edit-sch-date').value = b.date;
    $('edit-sch-time').value = b.time;
    if (b.repeat) {
      $('edit-sch-recurring-toggle').checked = true;
      window.toggleRecurringOptions();
      const p = b.date.split('-').map(Number), dow = new Date(p[0], p[1] - 1, p[2]).getDay();
      const dayBtn = document.querySelector('.recurring-day-btn[data-day="' + dow + '"]');
      if (dayBtn && !dayBtn.classList.contains('active')) window.toggleRecurringWeekday(dayBtn);
      return;
    }
    const form = $('form-edit-schedule');
    if (form.requestSubmit) form.requestSubmit(); else form.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
  }
  // "Ubah" pada sesi sendiri membuka tiga langkah; form lama tetap dipakai untuk mengirim (dan oleh pemeriksaan otomatis).
  const openRescheduleSheet = window.openRescheduleModal;
  window.openRescheduleModal = function (id, direct) { if (direct || !window.isPublicView) openRescheduleSheet(id); else window.bkOpen({ resched: id }); };
  document.addEventListener('keydown', function (e) { if (ui.bkOn && !ui.sheetOn && e.key === 'Escape') { e.preventDefault(); bkHide(); } });
})();
</script>