    $('wl-title').textContent = wl.loading ? 'Memuat…' : (wl.hari || 'Log latihan') + (wl.mode === 'admin' && wl.name ? ' · ' + String(wl.name).split(/\s+/)[0] : '');
    wlRenderSub();
